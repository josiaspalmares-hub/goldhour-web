---
// "Encuentra tu perfume": el cliente mueve tres controles y la web le recomienda 3 perfumes del catálogo.
// Todas las tarjetas se generan aquí (con su foto optimizada); el script solo elige cuáles mostrar y en qué orden.
import { Image } from 'astro:assets';
import { frascos, decants } from '../data/perfumes';
import { fotoDe } from '../data/fotos';

const todos = [...frascos, ...decants];
const notas = (p: (typeof todos)[number]) => [...p.ficha.salida, ...p.ficha.corazon, ...p.ficha.fondo].slice(0, 4).join(', ').toLowerCase();
---

<section id="encuentra" class="encuentra" aria-labelledby="encuentra-titulo">
  <div class="contenedor encuentra__grid">
    <div class="encuentra__controles">
      <p class="etiqueta">¿No sabes cuál elegir?</p>
      <h2 id="encuentra-titulo" class="encuentra__titulo">Encuentra tu perfume</h2>
      <p class="encuentra__texto">Mueve los controles y te recomendamos tres de nuestra vitrina. Es como pedirnos consejo por WhatsApp, pero al instante.</p>

      <fieldset class="control">
        <legend class="etiqueta">Es para</legend>
        <div class="opciones-para">
          {[['todos', 'Da igual'], ['Él', 'Él'], ['Ella', 'Ella'], ['Unisex', 'Unisex']].map(([v, t], i) => (
            <label class="chip"><input type="radio" name="para" value={v} checked={i === 0} /><span>{t}</span></label>
          ))}
        </div>
      </fieldset>

      <label class="control">
        <span class="control__cabeza"><span class="etiqueta">Estilo</span><b data-texto-estilo>Equilibrado</b></span>
        <input type="range" name="estilo" min="0" max="100" value="50" aria-label="Del más dulce al más fresco" />
        <span class="control__extremos"><span>Dulce</span><span>Fresco</span></span>
      </label>

      <label class="control">
        <span class="control__cabeza"><span class="etiqueta">Momento</span><b data-texto-momento>Todo el día</b></span>
        <input type="range" name="momento" min="0" max="100" value="50" aria-label="Del día a la noche" />
        <span class="control__extremos"><span>Día</span><span>Noche</span></span>
      </label>

      <fieldset class="control">
        <legend class="etiqueta">Presupuesto</legend>
        <div class="opciones-para">
          {[['0', 'Cualquiera'], ['60', 'Hasta $60'], ['150', 'Hasta $150']].map(([v, t], i) => (
            <label class="chip"><input type="radio" name="presupuesto" value={v} checked={i === 0} /><span>{t}</span></label>
          ))}
        </div>
      </fieldset>
    </div>

    <div class="encuentra__resultado">
      <!-- La gota cambia de color: verde agua si es fresco, ámbar si es dulce, más oscura si es de noche. -->
      <div class="gota" aria-hidden="true"><span class="gota__brillo"></span></div>
      <p class="etiqueta encuentra__sub" aria-live="polite" data-resumen>Tus tres recomendados</p>
      <ol class="recomendados" role="list" data-recomendados>
        {todos.map((p) => {
          const esDecant = p.tamanos.length > 1;
          const desde = esDecant ? `Decant desde $${p.tamanos[0].precio}` : `$${p.tamanos[0].precio}`;
          return (
            <li
              class="reco"
              hidden
              data-id={p.id}
              data-para={p.para}
              data-dulce={p.perfil.dulce}
              data-fresco={p.perfil.fresco}
              data-noche={p.perfil.noche}
              data-precio={esDecant ? 0 : p.tamanos[0].precio}
            >
              <Image class="reco__foto" src={fotoDe(p.id)} alt="" width={160} format="webp" loading="lazy" />
              <div class="reco__info">
                <p class="reco__casa">{p.casa}</p>
                <h3 class="reco__nombre">{p.nombre}</h3>
                <p class="reco__notas">{notas(p)}</p>
                <p class="reco__precio">{desde}</p>
              </div>
              <a class="reco__ver" href={`#${p.id}`}>Ver ficha</a>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>('#encuentra')!;
  const tarjetas = [...seccion.querySelectorAll<HTMLLIElement>('.reco')];
  const lista = seccion.querySelector<HTMLOListElement>('[data-recomendados]')!;
  const gota = seccion.querySelector<HTMLElement>('.gota')!;
  const textoEstilo = seccion.querySelector<HTMLElement>('[data-texto-estilo]')!;
  const textoMomento = seccion.querySelector<HTMLElement>('[data-texto-momento]')!;
  const resumen = seccion.querySelector<HTMLElement>('[data-resumen]')!;

  const valor = (nombre: string) => {
    const el = seccion.querySelector<HTMLInputElement>(`[name="${nombre}"]:checked, input[type="range"][name="${nombre}"]`);
    if (!el) throw new Error(`Falta el control ${nombre}`);
    return el.value;
  };
  const mezcla = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));

  function recomendar() {
    const estilo = Number(valor('estilo')) / 100; // 0 dulce · 1 fresco
    const momento = Number(valor('momento')) / 100; // 0 día · 1 noche
    const para = valor('para');
    const tope = Number(valor('presupuesto'));

    textoEstilo.textContent = estilo < 0.34 ? 'Dulce' : estilo > 0.66 ? 'Fresco' : 'Equilibrado';
    textoMomento.textContent = momento < 0.34 ? 'De día' : momento > 0.66 ? 'De noche' : 'Todo el día';

    // Color de la gota: del ámbar dulce al verde agua fresco, y más profundo de noche.
    const base = mezcla([214, 150, 62], [120, 205, 190], estilo);
    const color = mezcla(base, [70, 40, 20], momento * 0.45);
    gota.style.setProperty('--gota', `rgb(${color.join(',')})`);

    const objetivo = { dulce: (1 - estilo) * 10, fresco: estilo * 10, noche: momento * 10 };
    const candidatos = tarjetas
      .filter((t) => para === 'todos' || t.dataset.para === para || t.dataset.para === 'Unisex')
      .filter((t) => !tope || Number(t.dataset.precio) <= tope)
      .map((t) => {
        const d = Number(t.dataset.dulce), f = Number(t.dataset.fresco), n = Number(t.dataset.noche);
        const distancia = Math.abs(d - objetivo.dulce) + Math.abs(f - objetivo.fresco) + Math.abs(n - objetivo.noche) * 0.9;
        return { t, distancia };
      })
      // Más allá de 16 puntos ya no se parece a lo que pidió: mejor mostrar menos que recomendar lo opuesto.
      .filter(({ distancia }) => distancia <= 16)
      .sort((a, b) => a.distancia - b.distancia)
      .slice(0, 3);

    tarjetas.forEach((t) => (t.hidden = true));
    candidatos.forEach(({ t }, i) => {
      t.hidden = false;
      t.style.setProperty('--orden', String(i));
      lista.append(t); // las tres elegidas quedan arriba y en orden
    });
    resumen.textContent =
      candidatos.length === 3 ? 'Tus 3 recomendados'
      : candidatos.length ? 'Lo que más se acerca a lo que buscas'
      : 'No tenemos uno así en la vitrina. Prueba otra combinación o escríbenos.';
  }

  seccion.addEventListener('input', recomendar);
  seccion.addEventListener('change', recomendar);
  recomendar();
</script>

<style>
  .encuentra { padding-block: var(--e-9); border-top: 1px solid var(--linea); scroll-margin-top: 72px; }
  .encuentra__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--e-8); align-items: start; }
  .encuentra__titulo { font-family: var(--serif); font-size: var(--t-h2); font-weight: 500; color: var(--blanco); line-height: 1.05; margin: var(--e-3) 0 var(--e-4); }
  .encuentra__texto { margin: 0 0 var(--e-7); color: var(--texto-2); max-width: 32rem; }

  .control { display: grid; gap: var(--e-3); margin: 0 0 var(--e-6); padding: 0; border: 0; }
  .control__cabeza { display: flex; justify-content: space-between; align-items: baseline; }
  .control__cabeza b { font-family: var(--serif); font-weight: 500; font-size: 1.25rem; color: var(--oro-claro); }
  .control__extremos { display: flex; justify-content: space-between; font-size: var(--t-chico); color: var(--texto-2); }

  .opciones-para { display: flex; flex-wrap: wrap; gap: var(--e-2); }
  .chip { position: relative; }
  .chip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .chip span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--e-4); border: 1px solid var(--linea); border-radius: 999px; font-size: 0.875rem; pointer-events: none; transition: background-color 0.2s, color 0.2s, border-color 0.2s; }
  .chip:has(input:checked) span { background: var(--oro); border-color: var(--oro); color: var(--negro); }
  .chip:has(input:focus-visible) span { outline: 2px solid var(--oro); outline-offset: 3px; }

  input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 32px;
    background: transparent;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track { height: 2px; background: var(--linea); }
  input[type='range']::-moz-range-track { height: 2px; background: var(--linea); }
  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; margin-top: -11px; border-radius: 50%; background: var(--oro); border: 4px solid var(--negro); box-shadow: 0 0 0 1px var(--oro); }
  input[type='range']::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--oro); border: 4px solid var(--negro); }
  input[type='range']:focus-visible { outline: 2px solid var(--oro); outline-offset: 4px; }

  .encuentra__resultado { position: relative; display: grid; gap: var(--e-4); }
  /* Gota de perfume que toma el color de lo que eliges */
  .gota {
    --gota: rgb(214, 150, 62);
    justify-self: center;
    width: 92px;
    height: 92px;
    /* cuadrado con una esquina en punta y girado: queda la silueta de una gota */
    border-radius: 0 50% 50% 50%;
    rotate: 45deg;
    background:
      radial-gradient(circle at 42% 42%, rgba(255, 255, 255, 0.5), transparent 22%),
      radial-gradient(circle at 75% 75%, rgba(0, 0, 0, 0.3), transparent 55%),
      var(--gota);
    box-shadow: 18px 18px 50px -12px var(--gota);
    transition: background-color 0.5s, box-shadow 0.5s;
    margin: var(--e-5) 0 var(--e-4);
  }
  .encuentra__sub { text-align: center; }

  .recomendados { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--e-3); }
  .reco {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: var(--e-4);
    align-items: center;
    padding: var(--e-4);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: var(--negro-2);
    animation: reco-entra 0.45s var(--ease-salida) both;
    animation-delay: calc(var(--orden, 0) * 70ms);
  }
  .reco[hidden] { display: none; }
  @keyframes reco-entra { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) { .reco { animation: none; } }
  .reco :global(.reco__foto) { width: 72px; height: 88px; object-fit: contain; filter: drop-shadow(0 8px 8px rgba(0, 0, 0, 0.5)); }
  .reco__casa { margin: 0; font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--oro); }
  .reco__nombre { margin: 2px 0; font-family: var(--serif); font-size: 1.25rem; font-weight: 500; color: var(--blanco); line-height: 1.2; }
  .reco__notas { margin: 0; font-size: 0.8125rem; color: var(--texto-2); }
  .reco__precio { margin: var(--e-1) 0 0; font-family: var(--serif); color: var(--oro-claro); }
  .reco__ver { min-height: 44px; display: inline-flex; align-items: center; padding: 0 var(--e-4); border: 1px solid var(--linea); border-radius: var(--radio); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  .reco__ver:hover { border-color: var(--oro); color: var(--oro-claro); }

  @media (max-width: 767px) {
    .encuentra { padding-block: var(--e-8); }
    .encuentra__grid { grid-template-columns: 1fr; gap: var(--e-6); }
    .reco { grid-template-columns: 56px 1fr; }
    .reco :global(.reco__foto) { width: 56px; height: 72px; }
    .reco__ver { grid-column: 1 / -1; justify-content: center; }
  }
</style>
