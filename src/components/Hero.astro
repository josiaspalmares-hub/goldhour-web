---
import logoNombre from '../assets/marca/logo-nombre-oro.svg?raw';
import khamrah from '../assets/perfumes/khamrah-qahwa.png';
import leParfum from '../assets/perfumes/le-male-le-parfum.png';
import goodGirl from '../assets/perfumes/good-girl.png';
import FrascoLuz from './FrascoLuz.astro';
import { frascos, WHATSAPP } from '../data/perfumes';

// Los tres frascos de la vitrina de la portada, en el orden izquierda · frente · derecha.
const fotos = { 'le-male-le-parfum': leParfum, 'khamrah-qahwa': khamrah, 'good-girl': goodGirl };
const posiciones = ['izq', 'frente', 'der'] as const;
const escena = (Object.keys(fotos) as (keyof typeof fotos)[]).map((id, i) => {
  const perfume = frascos.find((p) => p.id === id);
  if (!perfume) throw new Error(`Falta ${id} en src/data/perfumes.ts`);
  return { perfume, foto: fotos[id], posicion: posiciones[i] };
});
const protagonista = escena[1].perfume;

const mensaje = encodeURIComponent('Hola Goldhour, vengo de la web y quiero información de un perfume.');
const confianza = ['100% originales y sellados', 'Decants desde $6', 'Pago móvil, Zelle, Binance o efectivo', 'Delivery en Caracas'];
---

<section id="inicio" class="hero" aria-labelledby="hero-titulo">
  <div class="hero__luz-fondo" aria-hidden="true"></div>

  <div class="hero__grid contenedor">
    <div class="hero__texto">
      <p class="etiqueta hero__paso">Maison de Parfums · Caracas</p>
      <h1 id="hero-titulo" class="hero__marca hero__paso">
        <span class="solo-lector">Goldhour</span>
        <span class="hero__logo" aria-hidden="true" set:html={logoNombre} />
      </h1>
      <p class="hero__lema hero__paso">Perfumes originales y sellados. Y decants para probarlos antes del frasco.</p>
      <div class="hero__acciones hero__paso">
        <a class="boton boton--principal" href={`https://wa.me/${WHATSAPP}?text=${mensaje}`} target="_blank" rel="noopener">
          Escríbenos por WhatsApp
        </a>
        <a class="boton boton--secundario" href="#vitrina">Ver la vitrina</a>
      </div>
    </div>

    <div class="hero__escena hero__paso">
      {escena.map(({ perfume, foto, posicion }) => (
        <button
          type="button"
          class={`hero__frasco hero__frasco--${posicion}`}
          data-id={perfume.id}
          data-casa={perfume.casa}
          data-nombre={perfume.nombre}
          data-precio={perfume.tamanos[0].precio}
          aria-label={`Poner ${perfume.nombre} al frente`}
        >
          <FrascoLuz
            foto={foto}
            alt={`Frasco de ${perfume.nombre} de ${perfume.casa}`}
            ancho={900}
            sizes="(max-width: 767px) 46vw, 28vw"
            principal={posicion === 'frente'}
          />
        </button>
      ))}
      <div class="hero__base" aria-hidden="true"></div>

      <a class="hero__precio" href={`#${protagonista.id}`} aria-live="polite">
        <span class="hero__precio-linea" aria-hidden="true"></span>
        <span class="etiqueta" data-precio-casa>{protagonista.casa}</span>
        <span class="hero__precio-nombre" data-precio-nombre>{protagonista.nombre}</span>
        <span class="hero__precio-monto" data-precio-monto>${protagonista.tamanos[0].precio}</span>
        <span class="hero__precio-ver">Ver ficha</span>
      </a>
    </div>
  </div>

  <ul class="hero__confianza contenedor hero__paso" aria-label="Por qué comprar en Goldhour">
    {confianza.map((item) => <li>{item}</li>)}
  </ul>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { Flip } from 'gsap/Flip';

  // En modo prueba (solo en la PC, nunca publicado) ?movimiento fuerza las animaciones
  // aunque Windows tenga apagados los efectos de animación.
  const forzarMovimiento = import.meta.env.DEV && new URLSearchParams(location.search).has('movimiento');
  const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches && !forzarMovimiento;
  const pasos = document.querySelectorAll('.hero__paso');

  // Tocar un frasco de atrás lo pasa al frente; tocar el del frente lleva a su ficha.
  gsap.registerPlugin(Flip);
  const frascosEscena = [...document.querySelectorAll<HTMLButtonElement>('.hero__frasco')];
  const etiqueta = document.querySelector<HTMLAnchorElement>('.hero__precio');
  const campo = (nombre: string) => etiqueta?.querySelector<HTMLElement>(`[data-precio-${nombre}]`);

  const actualizarEtiqueta = (frasco: HTMLButtonElement) => {
    const { id, casa, nombre, precio } = frasco.dataset;
    if (!etiqueta || !id || !casa || !nombre || !precio) {
      throw new Error('Frasco de la portada sin datos completos');
    }
    etiqueta.href = `#${id}`;
    campo('casa')!.textContent = casa;
    campo('nombre')!.textContent = nombre;
    campo('monto')!.textContent = `$${precio}`;
  };

  const marcarBotones = () => {
    frascosEscena.forEach((f) => {
      const alFrente = f.classList.contains('hero__frasco--frente');
      f.setAttribute('aria-label', alFrente ? `Ver la ficha de ${f.dataset.nombre}` : `Poner ${f.dataset.nombre} al frente`);
    });
  };
  marcarBotones();

  // La vitrina gira como una rueda: los tres frascos avanzan un puesto a la vez.
  // Tocar el de la derecha: derecha → frente, frente → izquierda, izquierda → derecha (pasando por detrás).
  type Puesto = 'izq' | 'frente' | 'der';
  const puestoDe = (f: HTMLElement): Puesto =>
    f.classList.contains('hero__frasco--frente') ? 'frente' : f.classList.contains('hero__frasco--izq') ? 'izq' : 'der';
  const siguiente: Record<'der' | 'izq', Record<Puesto, Puesto>> = {
    der: { der: 'frente', frente: 'izq', izq: 'der' },
    izq: { izq: 'frente', frente: 'der', der: 'izq' },
  };
  let girando = false;

  const girar = (hacia: 'der' | 'izq') => {
    if (girando) return;
    girando = true;
    const estado = Flip.getState(frascosEscena);
    const movimientos = frascosEscena.map((f) => ({ f, de: puestoDe(f), a: siguiente[hacia][puestoDe(f)] }));

    movimientos.forEach(({ f, de, a }) => f.classList.replace(`hero__frasco--${de}`, `hero__frasco--${a}`));
    const nuevoFrente = movimientos.find((m) => m.a === 'frente')!.f;
    actualizarEtiqueta(nuevoFrente);
    marcarBotones();

    // scale: true mueve los frascos con transformaciones (la tarjeta gráfica) en vez de
    // recalcular su tamaño en cada cuadro; la luz y el desenfoque se apagan mientras giran.
    const duracion = reducir ? 0.4 : 0.95;
    const escenaGiro = document.querySelector('.hero__escena');
    escenaGiro?.classList.add('hero__escena--girando');
    Flip.from(estado, {
      duration: duracion,
      ease: 'power2.inOut',
      scale: true,
      absolute: true,
      onComplete: () => {
        escenaGiro?.classList.remove('hero__escena--girando');
        girando = false;
      },
    });

    if (!reducir) {
      // Recorrido en arco, sin inclinar el frasco: los de delante suben un poco al pasar
      // y el que cruza por detrás se apaga y se hunde, como en una vitrina giratoria.
      movimientos.forEach(({ f, de, a }) => {
        const interior = f.querySelector('.frasco-luz');
        const porDetras = (de === 'izq' && a === 'der') || (de === 'der' && a === 'izq');
        gsap.fromTo(
          interior,
          { opacity: 1, y: 0 },
          {
            keyframes: porDetras
              ? [{ opacity: 0.2, y: 12, duration: duracion / 2 }, { opacity: 1, y: 0, duration: duracion / 2 }]
              : [{ y: -10, duration: duracion / 2 }, { y: 0, duration: duracion / 2 }],
            ease: 'sine.inOut',
          },
        );
      });
    }
    gsap.fromTo(etiqueta, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.35, delay: duracion * 0.55 });
  };

  let acabaDeDeslizar = false;

  frascosEscena.forEach((frasco) => {
    frasco.addEventListener('click', () => {
      // Un deslizamiento con el dedo no cuenta como toque.
      if (acabaDeDeslizar) {
        acabaDeDeslizar = false;
        return;
      }
      const puesto = puestoDe(frasco);
      if (puesto === 'frente') {
        if (etiqueta) location.hash = etiqueta.hash;
        return;
      }
      girar(puesto);
    });
  });

  // En el teléfono también se puede girar deslizando el dedo sobre los frascos.
  const escenaToque = document.querySelector<HTMLElement>('.hero__escena');
  let inicioX: number | null = null;
  escenaToque?.addEventListener('touchstart', (e) => { inicioX = e.touches[0].clientX; }, { passive: true });
  escenaToque?.addEventListener('touchend', (e) => {
    if (inicioX === null) return;
    const dx = e.changedTouches[0].clientX - inicioX;
    inicioX = null;
    if (Math.abs(dx) > 40) {
      acabaDeDeslizar = true;
      setTimeout(() => { acabaDeDeslizar = false; }, 400);
      girar(dx < 0 ? 'der' : 'izq');
    }
  });

  if (reducir) {
    gsap.set(pasos, { opacity: 1, y: 0 });
  } else {
    gsap.registerPlugin(ScrollTrigger);

    // Entrada por pasos: etiqueta → logo → lema → botones → frascos → franja de confianza.
    gsap.fromTo(pasos, { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.09, delay: 0.1 });

    // La hora dorada: la luz cruza los tres frascos mientras bajas, el de atrás un poco después.
    const recorrido = { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 0.6 };
    document.querySelectorAll('.hero__frasco .frasco-luz__franja').forEach((franja, i) => {
      gsap.fromTo(franja, { xPercent: -160 - i * 25 }, { xPercent: 160 - i * 25, ease: 'none', scrollTrigger: recorrido });
    });
    gsap.to('.hero__luz-fondo', { opacity: 0.55, ease: 'none', scrollTrigger: recorrido });

    // En computadora, la luz de fondo se corre un poco hacia el ratón.
    const escena = document.querySelector<HTMLElement>('.hero__escena');
    if (escena && window.matchMedia('(pointer: fine)').matches) {
      const moverX = gsap.quickTo('.hero__luz-fondo', 'x', { duration: 0.8, ease: 'power3.out' });
      const moverY = gsap.quickTo('.hero__luz-fondo', 'y', { duration: 0.8, ease: 'power3.out' });
      escena.addEventListener('pointermove', (e) => {
        const caja = escena.getBoundingClientRect();
        moverX(((e.clientX - caja.left) / caja.width - 0.5) * 120);
        moverY(((e.clientY - caja.top) / caja.height - 0.5) * 80);
      });
      escena.addEventListener('pointerleave', () => {
        moverX(0);
        moverY(0);
      });
    }
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding-block: var(--e-9) 0;
    isolation: isolate;
  }

  /* Luz cálida, como el sol de la tarde detrás de la vitrina. */
  .hero__luz-fondo {
    position: absolute;
    inset: -10% -15% 0 35%;
    background: radial-gradient(closest-side, rgba(201, 165, 92, 0.18), transparent 70%);
    z-index: -1;
    pointer-events: none;
  }

  .hero__grid {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--e-7);
  }

  .hero__texto { max-width: 36rem; }
  .hero__marca { margin: var(--e-5) 0 var(--e-6); line-height: 0; }
  .hero__logo :global(svg) { width: min(100%, 560px); height: auto; }

  .hero__lema {
    font-family: var(--serif);
    font-size: var(--t-h3);
    font-weight: 500;
    line-height: 1.25;
    color: var(--blanco);
    margin: 0 0 var(--e-6);
    max-width: 28ch;
  }

  .hero__acciones { display: flex; flex-wrap: wrap; gap: var(--e-3); }

  /* Escena de vitrina: un frasco protagonista y dos detrás, fuera de foco. */
  .hero__escena {
    position: relative;
    justify-self: center;
    width: min(100%, 560px);
    aspect-ratio: 1 / 1.05;
    perspective: 900px;
  }
  .hero__escena :global(.hero__frasco) {
    position: absolute;
    bottom: 14%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: filter 0.5s var(--ease-salida);
  }
  .hero__escena :global(.hero__frasco:focus-visible) { outline: 2px solid var(--oro); outline-offset: 6px; }
  .hero__escena--girando :global(.frasco-luz__brillo) { visibility: hidden; }
  .hero__escena--girando :global(.hero__frasco) { filter: none !important; transition: none; will-change: transform; }
  .hero__escena :global(.hero__frasco--frente) {
    /* Espacio fijo (no translate) para que la animación de cambio no lo descoloque. */
    left: 22%;
    width: 56%;
    height: 68%;
    z-index: 3;
    filter: drop-shadow(0 30px 30px rgba(0, 0, 0, 0.6));
  }
  .hero__escena :global(.hero__frasco--izq),
  .hero__escena :global(.hero__frasco--der) {
    /* Misma proporción que el puesto del frente (56 × 68 a la mitad), para que al girar
       el frasco solo cambie de tamaño y nunca se estire ni se aplaste. */
    width: 28%;
    height: 34%;
    bottom: 22%;
    filter: blur(0.6px) brightness(0.78) drop-shadow(0 18px 18px rgba(0, 0, 0, 0.5));
    z-index: 1;
  }
  .hero__escena :global(.hero__frasco--izq:hover),
  .hero__escena :global(.hero__frasco--der:hover),
  .hero__escena :global(.hero__frasco--izq:focus-visible),
  .hero__escena :global(.hero__frasco--der:focus-visible) {
    filter: blur(0) brightness(1) drop-shadow(0 18px 18px rgba(0, 0, 0, 0.5));
  }
  .hero__escena :global(.hero__frasco--izq) { left: 4%; }
  .hero__escena :global(.hero__frasco--der) { right: 4%; }

  .hero__base {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10%;
    height: 56px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(201, 165, 92, 0.28), rgba(201, 165, 92, 0.05) 60%, transparent 75%);
    z-index: 0;
  }

  /* Etiqueta de precio que señala al frasco protagonista. */
  .hero__precio {
    position: absolute;
    right: -4%;
    bottom: 2%;
    z-index: 4;
    display: grid;
    gap: 2px;
    padding: var(--e-3) var(--e-4);
    background: rgba(13, 13, 13, 0.82);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    text-decoration: none;
    min-width: 150px;
    transition: border-color 0.2s;
  }
  .hero__precio:hover { border-color: var(--oro); }
  .hero__precio-linea {
    position: absolute;
    right: 100%;
    top: 50%;
    width: 56px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--oro));
  }
  .hero__precio-nombre { font-family: var(--serif); font-size: 1.125rem; color: var(--blanco); line-height: 1.2; }
  .hero__precio-monto { font-family: var(--serif); font-size: 1.5rem; color: var(--oro-claro); line-height: 1.2; }
  .hero__precio-ver { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--texto-2); }

  /* Franja de confianza: responde lo primero que pregunta todo el mundo. */
  .hero__confianza {
    list-style: none;
    margin: var(--e-7) auto 0;
    padding-block: var(--e-5);
    border-top: 1px solid var(--linea);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--e-3) var(--e-5);
    font-size: var(--t-chico);
    letter-spacing: 0.08em;
    color: var(--texto-2);
  }
  .hero__confianza li { display: flex; align-items: center; gap: var(--e-3); }
  .hero__confianza li + li::before {
    content: '';
    width: 4px;
    height: 4px;
    background: var(--oro);
    rotate: 45deg;
  }

  .hero__paso { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .hero__paso { opacity: 1; }
  }

  @media (max-width: 767px) {
    .hero { padding-block: 76px 0; }
    .hero__grid { grid-template-columns: 1fr; gap: var(--e-4); }
    .hero__escena { order: -1; width: min(100%, 340px); aspect-ratio: 1 / 0.82; }
    .hero__escena :global(.hero__frasco--frente) { width: 44%; left: 28%; height: 72%; }
    .hero__escena :global(.hero__frasco--izq),
    .hero__escena :global(.hero__frasco--der) { width: 24%; height: 39.27%; }
    /* En el teléfono la etiqueta va en una línea debajo de los frascos para no taparlos. */
    .hero__precio {
      right: auto;
      left: 50%;
      bottom: 0;
      translate: -50% 0;
      display: flex;
      align-items: baseline;
      gap: var(--e-2);
      white-space: nowrap;
      min-width: 0;
      padding: var(--e-2) var(--e-3);
    }
    .hero__precio-linea,
    .hero__precio .etiqueta { display: none; }
    .hero__precio-nombre { font-size: 0.9375rem; }
    .hero__precio-monto { font-size: 1.0625rem; }
    .hero__marca { margin: var(--e-3) 0 var(--e-4); }
    .hero__lema { margin-bottom: var(--e-5); }
    .hero__acciones .boton { flex: 1 1 100%; }
    .hero__confianza { margin-top: var(--e-6); justify-content: flex-start; flex-direction: column; gap: var(--e-2); }
    .hero__confianza li + li::before { display: none; }
  }
</style>
