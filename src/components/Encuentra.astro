---
// "Encuentra tu perfume": el cliente mueve tres controles y la web le recomienda 3 perfumes de TODO el catálogo.
// Los perfumes vienen de Supabase (los mismos del catálogo); la lógica para elegirlos está en scripts/recomendador.ts.
import { WHATSAPP } from '../data/perfumes';
---

<section id="encuentra" class="encuentra" aria-labelledby="encuentra-titulo" data-whatsapp={WHATSAPP}>
  <div class="contenedor encuentra__grid">
    <div class="encuentra__controles">
      <p class="etiqueta">¿No sabes cuál elegir?</p>
      <h2 id="encuentra-titulo" class="encuentra__titulo">Encuentra tu perfume</h2>
      <p class="encuentra__texto">Mueve los controles y te recomendamos tres de entre más de 300 perfumes. Es como pedirnos consejo por WhatsApp, pero al instante.</p>

      <fieldset class="control">
        <legend class="etiqueta">Es para</legend>
        <div class="opciones-para">
          {[['todos', 'Da igual'], ['Él', 'Él'], ['Ella', 'Ella'], ['Unisex', 'Unisex']].map(([v, t], i) => (
            <label class="chip"><input type="radio" name="para" value={v} checked={i === 0} /><span>{t}</span></label>
          ))}
        </div>
      </fieldset>

      <label class="control">
        <span class="control__cabeza"><span class="etiqueta">Estilo</span><b data-texto-estilo>Equilibrado</b></span>
        <input type="range" name="estilo" min="0" max="100" value="50" aria-label="Del más dulce al más fresco" />
        <span class="control__extremos"><span>Dulce</span><span>Fresco</span></span>
      </label>

      <label class="control">
        <span class="control__cabeza"><span class="etiqueta">Momento</span><b data-texto-momento>Todo el día</b></span>
        <input type="range" name="momento" min="0" max="100" value="50" aria-label="Del día a la noche" />
        <span class="control__extremos"><span>Día</span><span>Noche</span></span>
      </label>

      <fieldset class="control">
        <legend class="etiqueta">Presupuesto</legend>
        <div class="opciones-para">
          {[['0', 'Cualquiera'], ['60', 'Hasta $60'], ['150', 'Hasta $150']].map(([v, t], i) => (
            <label class="chip"><input type="radio" name="presupuesto" value={v} checked={i === 0} /><span>{t}</span></label>
          ))}
        </div>
      </fieldset>
    </div>

    <div class="encuentra__resultado">
      <!-- La gota cambia de color: verde agua si es fresco, ámbar si es dulce, más oscura si es de noche. -->
      <div class="gota" aria-hidden="true"><span class="gota__brillo"></span></div>
      <p class="etiqueta encuentra__sub" aria-live="polite" data-resumen>Tus tres recomendados</p>
      <ol class="recomendados" role="list" data-recomendados aria-busy="true">
        {[0, 1, 2].map(() => (
          <li class="reco reco--cargando" aria-hidden="true"><span class="reco__hueco"></span><span class="reco__rayas"><i></i><i></i></span></li>
        ))}
      </ol>
      <div class="encuentra__aviso" data-aviso hidden></div>
    </div>
  </div>
</section>

<script>
  import { leerCatalogo, type PerfumeCatalogo } from '../scripts/supabase';
  import { recomendar, type Criterios } from '../scripts/recomendador';
  import { pedido } from '../scripts/pedido';
  import { medir } from '../scripts/medir';
  import { formatoUsd } from '../scripts/tasa';

  const seccion = document.querySelector<HTMLElement>('#encuentra')!;
  const lista = seccion.querySelector<HTMLOListElement>('[data-recomendados]')!;
  const aviso = seccion.querySelector<HTMLElement>('[data-aviso]')!;
  const gota = seccion.querySelector<HTMLElement>('.gota')!;
  const textoEstilo = seccion.querySelector<HTMLElement>('[data-texto-estilo]')!;
  const textoMomento = seccion.querySelector<HTMLElement>('[data-texto-momento]')!;
  const resumen = seccion.querySelector<HTMLElement>('[data-resumen]')!;
  const WA = seccion.dataset.whatsapp!;
  let catalogo: PerfumeCatalogo[] = [];

  const valor = (nombre: string) => {
    const el = seccion.querySelector<HTMLInputElement>(`[name="${nombre}"]:checked, input[type="range"][name="${nombre}"]`);
    if (!el) throw new Error(`Falta el control ${nombre}`);
    return el.value;
  };
  const mezcla = (a: number[], b: number[], t: number) => a.map((v, i) => Math.round(v + (b[i] - v) * t));
  function el<K extends keyof HTMLElementTagNameMap>(tag: K, clase?: string, texto?: string) {
    const n = document.createElement(tag);
    if (clase) n.className = clase;
    if (texto !== undefined) n.textContent = texto;
    return n;
  }
  const casa = (nombre: string) => nombre.split(' ')[0];

  function criterios(): Criterios {
    return {
      para: valor('para') as Criterios['para'],
      estilo: Number(valor('estilo')) / 100,
      momento: Number(valor('momento')) / 100,
      tope: Number(valor('presupuesto')),
    };
  }

  // Lo visual responde al instante aunque el catálogo todavía esté llegando
  function pintarControles(c: Criterios) {
    textoEstilo.textContent = c.estilo < 0.34 ? 'Dulce' : c.estilo > 0.66 ? 'Fresco' : 'Equilibrado';
    textoMomento.textContent = c.momento < 0.34 ? 'De día' : c.momento > 0.66 ? 'De noche' : 'Todo el día';
    // Color de la gota: del ámbar dulce al verde agua fresco, y más profundo de noche.
    const base = mezcla([214, 150, 62], [120, 205, 190], c.estilo);
    gota.style.setProperty('--gota', `rgb(${mezcla(base, [70, 40, 20], c.momento * 0.45).join(',')})`);
  }

  function tarjeta(p: PerfumeCatalogo, i: number) {
    const li = el('li', 'reco');
    li.style.setProperty('--orden', String(i));
    const foto = el('span', 'reco__foto');
    if (p.foto_url) {
      const img = el('img'); img.src = p.foto_url; img.alt = ''; img.width = 88; img.height = 88; img.loading = 'lazy'; img.decoding = 'async';
      foto.append(img);
    } else foto.append(el('span', 'reco__marca', casa(p.nombre)));
    // Toda la tarjeta abre la ficha: el botón del nombre se estira sobre ella (menos sobre "Agregar")
    const nombre = el('h3', 'reco__nombre');
    const abrir = el('button', 'reco__abrir', p.nombre); abrir.type = 'button';
    abrir.setAttribute('aria-label', `${p.nombre}: ver la ficha`);
    abrir.addEventListener('click', () => document.dispatchEvent(new CustomEvent('gh:ver-perfume', { detail: { slug: p.slug } })));
    nombre.append(abrir);
    const info = el('div', 'reco__info');
    info.append(el('p', 'reco__casa', `${p.categoria} · ${p.estado === 'disponible' ? 'Disponible ya' : 'Por encargo'}`), nombre);
    if (p.notas) info.append(el('p', 'reco__notas', p.notas.split('·').map((t) => t.trim()).filter(Boolean).slice(0, 2).join(' · ')));
    info.append(el('p', 'reco__precio', formatoUsd(Number(p.precio_usd))));

    const acciones = el('div', 'reco__acciones');
    const agregar = el('button', 'reco__boton reco__boton--oro', 'Agregar'); agregar.type = 'button';
    agregar.addEventListener('click', () => {
      const tamano = p.estado === 'disponible' ? 'Frasco' : 'Frasco · por encargo (3 a 5 días)';
      pedido.agregar({ id: `cat-${p.slug}`, nombre: p.nombre, casa: casa(p.nombre), tamano, precio: Number(p.precio_usd) });
      medir('agregar', { perfume: p.nombre, detalle: 'recomendado' });
      agregar.textContent = 'Agregado'; agregar.disabled = true;
      setTimeout(() => { agregar.textContent = 'Agregar'; agregar.disabled = false; }, 1600);
    });
    acciones.append(agregar);
    li.append(foto, info, acciones);
    return li;
  }

  function mostrarAviso(texto: string, enlace?: string) {
    aviso.replaceChildren(el('p', undefined, texto));
    if (enlace) {
      const a = el('a', 'reco__boton', 'Pedir consejo por WhatsApp');
      a.href = `https://wa.me/${WA}?text=${encodeURIComponent(enlace)}`; a.target = '_blank'; a.rel = 'noopener';
      aviso.append(a);
    }
    aviso.hidden = false;
  }

  function recomendarAhora() {
    const c = criterios();
    pintarControles(c);
    if (!catalogo.length) return;
    const elegidos = recomendar(catalogo, c);
    lista.replaceChildren(...elegidos.map(tarjeta));
    lista.removeAttribute('aria-busy');
    aviso.hidden = true;
    resumen.textContent = elegidos.length === 3 ? 'Tus 3 recomendados' : elegidos.length ? 'Lo que más se acerca a lo que buscas' : 'Tus recomendados';
    if (!elegidos.length) mostrarAviso('Con ese presupuesto no tenemos uno así ahora. Prueba otra combinación o pídenos consejo.', 'Hola, Goldhour. ¿Me ayudan a elegir un perfume?');
  }

  async function cargar() {
    try {
      catalogo = await leerCatalogo();
      recomendarAhora();
    } catch (error) {
      console.error('No se pudo cargar el catálogo para recomendar:', error);
      lista.replaceChildren();
      lista.removeAttribute('aria-busy');
      mostrarAviso('No pudimos cargar las recomendaciones en este momento. Escríbenos y te recomendamos uno al instante.', 'Hola, Goldhour. ¿Me ayudan a elegir un perfume?');
      const reintentar = el('button', 'reco__boton reco__boton--oro', 'Intentar de nuevo'); reintentar.type = 'button';
      reintentar.addEventListener('click', () => { aviso.hidden = true; cargar(); });
      aviso.append(reintentar);
    }
  }

  seccion.addEventListener('input', recomendarAhora);
  seccion.addEventListener('change', recomendarAhora);
  pintarControles(criterios());
  // El catálogo se pide cuando la sección se acerca a la pantalla, para no frenar la portada
  new IntersectionObserver(([e], o) => { if (e.isIntersecting) { o.disconnect(); cargar(); } }, { rootMargin: '600px' }).observe(seccion);
</script>

<style>
  .encuentra { padding-block: var(--e-9); border-top: 1px solid var(--linea); scroll-margin-top: 72px; }
  .encuentra__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--e-8); align-items: start; }
  .encuentra__titulo { font-family: var(--serif); font-size: var(--t-h2); font-weight: 500; color: var(--blanco); line-height: 1.05; margin: var(--e-3) 0 var(--e-4); }
  .encuentra__texto { margin: 0 0 var(--e-7); color: var(--texto-2); max-width: 32rem; }

  .control { display: grid; gap: var(--e-3); margin: 0 0 var(--e-6); padding: 0; border: 0; }
  .control__cabeza { display: flex; justify-content: space-between; align-items: baseline; }
  .control__cabeza b { font-family: var(--serif); font-weight: 500; font-size: 1.25rem; color: var(--oro-claro); }
  .control__extremos { display: flex; justify-content: space-between; font-size: var(--t-chico); color: var(--texto-2); }

  .opciones-para { display: flex; flex-wrap: wrap; gap: var(--e-2); }
  .chip { position: relative; }
  .chip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .chip span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--e-4); border: 1px solid var(--linea); border-radius: 999px; font-size: 0.875rem; pointer-events: none; transition: background-color 0.2s, color 0.2s, border-color 0.2s; }
  .chip:has(input:checked) span { background: var(--oro); border-color: var(--oro); color: var(--negro); }
  .chip:has(input:focus-visible) span { outline: 2px solid var(--oro); outline-offset: 3px; }

  input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 32px;
    background: transparent;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track { height: 2px; background: var(--linea); }
  input[type='range']::-moz-range-track { height: 2px; background: var(--linea); }
  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; margin-top: -11px; border-radius: 50%; background: var(--oro); border: 4px solid var(--negro); box-shadow: 0 0 0 1px var(--oro); }
  input[type='range']::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--oro); border: 4px solid var(--negro); }
  input[type='range']:focus-visible { outline: 2px solid var(--oro); outline-offset: 4px; }

  .encuentra__resultado { position: relative; display: grid; gap: var(--e-4); }
  /* Gota de perfume que toma el color de lo que eliges */
  .gota {
    --gota: rgb(214, 150, 62);
    justify-self: center;
    width: 92px;
    height: 92px;
    /* cuadrado con una esquina en punta y girado: queda la silueta de una gota */
    border-radius: 0 50% 50% 50%;
    rotate: 45deg;
    background:
      radial-gradient(circle at 42% 42%, rgba(255, 255, 255, 0.5), transparent 22%),
      radial-gradient(circle at 75% 75%, rgba(0, 0, 0, 0.3), transparent 55%),
      var(--gota);
    box-shadow: 18px 18px 50px -12px var(--gota);
    transition: background-color 0.5s, box-shadow 0.5s;
    margin: var(--e-5) 0 var(--e-4);
  }
  .encuentra__sub { text-align: center; }

  .recomendados { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--e-3); }
  .recomendados :global(.reco) {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: var(--e-4);
    align-items: center;
    padding: var(--e-4);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    background: var(--negro-2);
    animation: reco-entra 0.45s var(--ease-salida) both;
    animation-delay: calc(var(--orden, 0) * 70ms);
  }
  .recomendados :global(.reco__foto) { width: 72px; height: 88px; display: grid; place-items: center; overflow: hidden; border-radius: var(--radio); background: #f4f1ec; }
  .recomendados :global(.reco__foto img) { width: 100%; height: 100%; object-fit: contain; }
  .recomendados :global(.reco__marca) { font-family: var(--serif); color: var(--oro-oscuro); }
  .recomendados :global(.reco__acciones) { position: relative; z-index: 1; display: grid; gap: var(--e-2); }
  .recomendados :global(.reco) { position: relative; cursor: pointer; transition: border-color 0.2s; }
  .recomendados :global(.reco:hover) { border-color: var(--oro); }
  .recomendados :global(.reco__abrir) { all: unset; cursor: pointer; }
  .recomendados :global(.reco__abrir::after) { content: ''; position: absolute; inset: 0; }
  .recomendados :global(.reco__abrir:focus-visible::after) { outline: 2px solid var(--oro); outline-offset: 2px; }
  .encuentra :global(.reco__boton) { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: 0 var(--e-4); border: 1px solid var(--linea); border-radius: var(--radio); background: none; color: var(--texto); font: inherit; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; white-space: nowrap; cursor: pointer; }
  .encuentra :global(.reco__boton:hover) { border-color: var(--oro); color: var(--oro-claro); }
  .encuentra :global(.reco__boton--oro) { background: var(--oro); border-color: var(--oro); color: var(--negro); }
  .encuentra :global(.reco__boton--oro:hover) { background: var(--oro-claro); color: var(--negro); }
  .encuentra :global(.reco__boton:disabled) { opacity: 0.7; cursor: default; }
  .reco--cargando { min-height: 120px; }
  .reco__hueco, .reco__rayas i { background: linear-gradient(90deg, #1d1b18 0%, #26231f 50%, #1d1b18 100%); background-size: 200% 100%; animation: brillo-reco 1.4s ease-in-out infinite; }
  .reco__hueco { width: 72px; height: 88px; border-radius: var(--radio); }
  .reco__rayas { display: grid; gap: var(--e-2); grid-column: 2 / -1; }
  .reco__rayas i { display: block; height: 12px; border-radius: 2px; }
  .reco__rayas i + i { width: 60%; }
  @keyframes brillo-reco { to { background-position: -200% 0; } }
  @media (prefers-reduced-motion: reduce) { .reco__hueco, .reco__rayas i { animation: none; } }
  .encuentra__aviso { display: grid; gap: var(--e-3); justify-items: center; text-align: center; color: var(--texto-2); }
  .encuentra__aviso[hidden] { display: none; }
  .encuentra__aviso p { margin: 0; }
  @keyframes reco-entra { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) { .recomendados :global(.reco) { animation: none; } }
  .recomendados :global(.reco__casa) { margin: 0; font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--oro); }
  .recomendados :global(.reco__nombre) { margin: 2px 0; font-family: var(--serif); font-size: 1.25rem; font-weight: 500; color: var(--blanco); line-height: 1.2; }
  .recomendados :global(.reco__notas) { margin: 0; font-size: 0.8125rem; color: var(--texto-2); }
  .recomendados :global(.reco__precio) { margin: var(--e-1) 0 0; font-family: var(--serif); color: var(--oro-claro); }

  @media (max-width: 767px) {
    .encuentra { padding-block: var(--e-8); }
    .encuentra__grid { grid-template-columns: 1fr; gap: var(--e-6); }
    .recomendados :global(.reco) { grid-template-columns: 64px 1fr; }
    .recomendados :global(.reco__foto) { width: 64px; height: 80px; }
    .recomendados :global(.reco__acciones) { grid-column: 1 / -1; }
  }
</style>
