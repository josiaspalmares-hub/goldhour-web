---
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import Ficha from './Ficha.astro';
import SelectorTamano from './SelectorTamano.astro';
import { decants } from '../data/perfumes';
import { fotoDe } from '../data/fotos';
import frasquito from '../assets/marca/frasquito-decant.png';

// Foto real del frasquito de vidrio con tapa negra que se usa para los decants (vacío).
const fotoFrasquito = await getImage({ src: frasquito, width: 160, format: 'webp' });
---

<section id="decants" class="decants" aria-labelledby="decants-titulo">
  <div class="contenedor">
    <header class="decants__cabeza">
      <p class="etiqueta">Decants</p>
      <h2 id="decants-titulo" class="decants__titulo">Pruébalo antes de comprar el frasco</h2>
      <p class="decants__texto">
        Envasamos el perfume original en un atomizador de vidrio de Goldhour. 5 ml dan para unas 50 aplicaciones:
        suficiente para saber cómo te dura y si es para ti.
      </p>
    </header>

    <ul class="decants__lista" role="list">
      {decants.map((p) => (
        <li class="decant" id={p.id} data-producto data-elegido={p.tamanos[0].etiqueta}>
          <button type="button" class="decant__foto" data-abrir-ficha={p.id} aria-label={`Ver la ficha de ${p.nombre}`}>
            <Image class="decant__frasco" src={fotoDe(p.id)} alt="" width={420} format="webp" loading="lazy" />
            <span class="decant__frasquitos" aria-hidden="true">
              <img class="decant__frasquito" data-tam="5 ml" src={fotoFrasquito.src} width={frasquito.width} height={frasquito.height} alt="" loading="lazy" />
              <img class="decant__frasquito" data-tam="10 ml" src={fotoFrasquito.src} width={frasquito.width} height={frasquito.height} alt="" loading="lazy" />
            </span>
          </button>

          <div class="decant__info">
            <p class="etiqueta">{p.casa}</p>
            <h3 class="decant__nombre">{p.nombre}</h3>
            <p class="decant__frase">{p.frase}</p>
            <SelectorTamano perfume={p} grupo={`tam-${p.id}`} />
            <div class="decant__acciones">
              <button type="button" class="boton boton--oscuro" data-agregar data-id={p.id} data-nombre={p.nombre} data-casa={p.casa}>
                <span data-texto>Agregar</span>
              </button>
              <button type="button" class="decant__ver" data-abrir-ficha={p.id}>Ver ficha</button>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>

  {decants.map((p) => (
    <Ficha perfume={p} tema="marfil">
      <div class="ficha-decant" data-producto>
        <SelectorTamano perfume={p} grupo={`ficha-tam-${p.id}`} />
        <button type="button" class="boton boton--oscuro" data-agregar data-id={p.id} data-nombre={p.nombre} data-casa={p.casa}>
          <span data-texto>Agregar al pedido</span>
        </button>
      </div>
    </Ficha>
  ))}
</section>

<script>
  // Al elegir 5 ml o 10 ml se enciende ese frasquito; con el frasco completo se atenúan los dos.
  document.querySelectorAll<HTMLElement>('.decant').forEach((tarjeta) => {
    tarjeta.addEventListener('change', (e) => {
      const opcion = e.target as HTMLInputElement;
      if (opcion.type === 'radio') tarjeta.dataset.elegido = opcion.value;
    });
  });
</script>

<style>
  .decants {
    background: var(--marfil);
    color: var(--tinta);
    padding-block: var(--e-9);
    scroll-margin-top: 72px;
  }
  .decants .etiqueta { color: var(--oro-oscuro); }

  .decants__cabeza { max-width: 40rem; margin-bottom: var(--e-8); }
  .decants__titulo { font-family: var(--serif); font-size: var(--t-h2); font-weight: 500; line-height: 1.05; margin: var(--e-3) 0 var(--e-4); color: var(--tinta); }
  .decants__texto { margin: 0; font-size: 1.0625rem; color: #4a4540; max-width: 34rem; }

  .decants__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--e-8) var(--e-7);
  }

  /* Tarjeta ancha: el frasco original con el frasquito al frente, y a su lado la información. */
  .decant { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--e-5); align-items: center; }

  .decant__foto {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    border: 0;
    padding: 0;
    border-radius: var(--radio);
    background: radial-gradient(70% 28% at 50% 90%, rgba(138, 102, 36, 0.18), transparent 70%), #e9e1d2;
    cursor: pointer;
    overflow: hidden;
  }
  .decant__foto :global(.decant__frasco) {
    position: absolute;
    inset: 10% 26% 12% 8%;
    width: 66%;
    height: 78%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 16px 14px rgba(0, 0, 0, 0.28));
    transition: transform 0.4s var(--ease-salida);
  }
  /* Los dos frasquitos (5 ml y 10 ml) al pie del perfume; el tamaño elegido se ve encendido. */
  .decant__frasquitos {
    position: absolute;
    right: 5%;
    bottom: 12%;
    height: 58%;
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }
  .decant__frasquito {
    width: auto;
    filter: drop-shadow(0 8px 6px rgba(0, 0, 0, 0.22));
    transition: opacity 0.3s, transform 0.4s var(--ease-salida);
  }
  .decant__frasquito[data-tam='10 ml'] { height: 100%; }
  .decant__frasquito[data-tam='5 ml'] { height: 66%; }
  .decant .decant__frasquito { opacity: 0.4; }
  .decant[data-elegido='5 ml'] .decant__frasquito[data-tam='5 ml'],
  .decant[data-elegido='10 ml'] .decant__frasquito[data-tam='10 ml'] { opacity: 1; transform: translateY(-4px); }
  .decant__foto:hover :global(.decant__frasco) { transform: translateY(-4px); }
  @media (prefers-reduced-motion: reduce) {
    .decant__foto:hover :global(.decant__frasco),
    .decant__frasquito { transform: none !important; }
  }

  .decant__nombre { font-family: var(--serif); font-size: 1.625rem; font-weight: 500; line-height: 1.15; margin: var(--e-1) 0 var(--e-2); color: var(--tinta); }
  .decant__frase { margin: 0 0 var(--e-4); font-size: 0.9375rem; color: #4a4540; }

  .decant__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-4); margin-top: var(--e-4); }
  .decant__ver {
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    border-bottom: 1px solid currentColor;
    color: var(--tinta);
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .ficha-decant { display: grid; gap: var(--e-4); }
  .ficha-decant .boton { justify-self: start; }

  @media (max-width: 899px) {
    .decants__lista { grid-template-columns: 1fr; gap: var(--e-7); }
  }
  @media (max-width: 767px) {
    .decants { padding-block: var(--e-8); }
    .decants__cabeza { margin-bottom: var(--e-6); }
    .decant { grid-template-columns: 1fr; }
    .decant__foto { aspect-ratio: 5 / 4; }
    .decant__foto :global(.decant__frasco) { inset: 10% 30% 12% 20%; width: 50%; }
    .decant__frasquitos { right: 14%; height: 50%; }
    .ficha-decant {
      position: sticky;
      bottom: 0;
      margin: 0 calc(var(--e-5) * -1) calc(var(--e-5) * -1);
      padding: var(--e-3) var(--e-5);
      background: var(--fondo-ficha);
      border-top: 1px solid var(--linea);
    }
    .ficha-decant .boton { justify-self: stretch; }
  }
</style>
