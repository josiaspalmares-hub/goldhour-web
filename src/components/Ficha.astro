---
// Ficha honesta de un perfume, en una ventana que se abre sobre la página.
import { Image } from 'astro:assets';
import Nivel from './Nivel.astro';
import Frasquitos from './Frasquitos.astro';
import type { Perfume } from '../data/perfumes';
import { fotoDe } from '../data/fotos';

interface Props {
  perfume: Perfume;
  // La ficha toma el color de la sección de donde se abre: negra en la vitrina, marfil en los decants.
  tema?: 'negro' | 'marfil';
}
const { perfume, tema = 'negro' } = Astro.props;
// En los decants se muestra el frasquito del tamaño elegido; arranca con el primero.
const esDecant = perfume.tamanos.length > 1;
const { ficha } = perfume;
const piramide = [
  { nombre: 'Salida', notas: ficha.salida },
  { nombre: 'Corazón', notas: ficha.corazon },
  { nombre: 'Fondo', notas: ficha.fondo },
];
---

<dialog
  class={`ficha ficha--${tema}`}
  id={`ficha-${perfume.id}`}
  aria-labelledby={`ficha-${perfume.id}-titulo`}
  data-elegido={esDecant ? perfume.tamanos[0].etiqueta : undefined}
>
  <div class="ficha__caja">
    <button type="button" class="ficha__cerrar" data-cerrar-ficha aria-label="Cerrar la ficha">Cerrar</button>

    <div class={`ficha__foto ${esDecant ? 'ficha__foto--decant' : ''}`}>
      <Image class="ficha__frasco" src={fotoDe(perfume.id)} alt={`Frasco de ${perfume.nombre}`} width={560} format="webp" loading="lazy" />
      {esDecant && <span class="ficha__frasquitos"><Frasquitos /></span>}
    </div>

    <div class="ficha__datos">
      <p class="etiqueta">{perfume.casa} · {perfume.para}</p>
      <h3 id={`ficha-${perfume.id}-titulo`} class="ficha__nombre">{perfume.nombre}</h3>
      <p class="ficha__sub">{perfume.concentracion} · {ficha.familia}</p>
      <p class="ficha__frase">{perfume.frase}</p>

      <dl class="ficha__piramide">
        {piramide.map((p) => (
          <div>
            <dt class="etiqueta">{p.nombre}</dt>
            <dd>{p.notas.join(' · ')}</dd>
          </div>
        ))}
      </dl>

      <div class="ficha__niveles">
        <Nivel titulo="Duración" valor={ficha.duracion} nivel={ficha.duracionNivel} />
        <Nivel titulo="Proyección" valor={ficha.proyeccion} nivel={ficha.proyeccionNivel} />
        <div class="ficha__ocasion">
          <span class="etiqueta">Ocasión</span>
          <span>{ficha.ocasion.join(' · ')}</span>
        </div>
      </div>

      <slot />
    </div>
  </div>
</dialog>

<style>
  .ficha {
    width: min(920px, calc(100vw - 32px));
    max-height: calc(100svh - 32px);
    padding: 0;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    --fondo-ficha: var(--negro);
    background: var(--fondo-ficha);
    color: var(--texto);
    overflow: auto;
  }
  /* Versión marfil: se redefinen los colores solo dentro de la ficha, todo lo demás se adapta solo. */
  .ficha--marfil {
    --fondo-ficha: var(--marfil);
    --blanco: var(--tinta);
    --texto: #3a3530;
    --texto-2: #6b645b;
    --oro: var(--oro-oscuro);
    --linea: rgba(27, 27, 27, 0.16);
  }
  .ficha--marfil::backdrop { background: rgba(27, 22, 15, 0.55); }
  .ficha--marfil .ficha__foto { background: radial-gradient(closest-side at 50% 80%, rgba(138, 102, 36, 0.18), transparent 70%); }
  .ficha--marfil .ficha__foto :global(.ficha__frasco) { filter: drop-shadow(0 20px 18px rgba(0, 0, 0, 0.28)); }
  .ficha::backdrop { background: rgba(0, 0, 0, 0.75); }
  .ficha[open] { animation: ficha-entra 0.35s var(--ease-salida); }
  @keyframes ficha-entra { from { opacity: 0; transform: translateY(12px); } }
  @media (prefers-reduced-motion: reduce) { .ficha[open] { animation: none; } }

  .ficha__caja {
    position: relative;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--e-6);
    padding: var(--e-7);
  }

  .ficha__cerrar {
    position: absolute;
    top: var(--e-3);
    right: var(--e-3);
    min-height: 44px;
    padding: 0 var(--e-4);
    background: none;
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    color: var(--texto);
    font: inherit;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .ficha__cerrar:hover { border-color: var(--oro); }

  .ficha__foto {
    display: grid;
    place-items: end center;
    background: radial-gradient(closest-side at 50% 80%, rgba(201, 165, 92, 0.18), transparent 70%);
  }
  .ficha__foto :global(.ficha__frasco) { max-height: 420px; width: auto; object-fit: contain; filter: drop-shadow(0 24px 24px rgba(0, 0, 0, 0.6)); }
  /* Decant: el frasco un poco a la izquierda y, a su lado, el frasquito del tamaño elegido. */
  .ficha__foto--decant { position: relative; place-items: end start; padding-right: 26%; }
  .ficha__foto--decant :global(.ficha__frasco) { max-height: 400px; }
  .ficha__frasquitos { position: absolute; right: 6%; bottom: 0; width: 18%; height: 62%; }
  .ficha__frasquitos :global(.frasquitos) { inset: 0; }

  .ficha__nombre { font-family: var(--serif); font-size: var(--t-h3); font-weight: 500; color: var(--blanco); margin: var(--e-2) 0 var(--e-1); line-height: 1.15; }
  .ficha__sub { margin: 0; color: var(--texto-2); font-size: 0.9375rem; }
  .ficha__frase { margin: var(--e-4) 0 var(--e-5); font-family: var(--serif); font-size: 1.125rem; color: var(--texto); }

  .ficha__piramide { margin: 0 0 var(--e-5); display: grid; gap: var(--e-3); padding-block: var(--e-4); border-block: 1px solid var(--linea); }
  .ficha__piramide div { display: grid; grid-template-columns: 100px 1fr; gap: var(--e-3); align-items: baseline; }
  .ficha__piramide dd { margin: 0; color: var(--blanco); }

  .ficha__niveles { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--e-5); margin-bottom: var(--e-6); }
  .ficha__ocasion { display: grid; gap: var(--e-1); align-content: start; }
  .ficha__ocasion span:last-child { font-family: var(--serif); color: var(--blanco); line-height: 1.35; }

  @media (max-width: 767px) {
    .ficha__caja { grid-template-columns: 1fr; padding: var(--e-7) var(--e-5) var(--e-5); gap: var(--e-4); }
    .ficha__foto :global(.ficha__frasco) { max-height: 220px; }
    .ficha__foto--decant { place-items: end center; padding-right: 0; }
    .ficha__foto--decant :global(.ficha__frasco) { max-height: 220px; translate: -22% 0; }
    .ficha__frasquitos { right: 18%; width: 12%; height: 70%; }
    .ficha__niveles { grid-template-columns: 1fr 1fr; }
    .ficha__ocasion { grid-column: 1 / -1; }
    .ficha__piramide div { grid-template-columns: 80px 1fr; }
  }
</style>
