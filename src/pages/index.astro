---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Hero from '../components/Hero.astro';
import Vitrina from '../components/Vitrina.astro';
import Decants from '../components/Decants.astro';
import Pedido from '../components/Pedido.astro';

// Temporal: estas secciones se construyen en los próximos pasos.
const pendientes = [{ id: 'como-comprar', texto: 'Aquí va cómo comprar' }];
---

<Base
  titulo="Goldhour · Perfumes originales y decants en Caracas"
  descripcion="Perfumes originales y sellados en Caracas: Lattafa, Lancôme, Carolina Herrera, Paco Rabanne, Valentino y más. Decants de 5 y 10 ml. Pedidos por WhatsApp."
>
  <Encabezado />
  <main>
    <Hero />
    <Vitrina />
    <Decants />
    {pendientes.map((p) => (
      <section id={p.id} style="min-height:40svh;display:grid;place-items:center;border-top:1px solid var(--linea);scroll-margin-top:72px">
        <p class="etiqueta">{p.texto}</p>
      </section>
    ))}
  </main>
  <Pedido />
</Base>
