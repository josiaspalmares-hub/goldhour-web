---
// Frasquito decant de Goldhour (atomizador de vidrio con tapa dorada y etiqueta), dibujado en SVG.
// El líquido toma el color del perfume.
interface Props {
  tinte: string;
  id: string;
}
const { tinte, id } = Astro.props;
const g = `dec-${id}`;
---

<svg class="frasquito" viewBox="0 0 60 170" role="img" aria-label="Decant de Goldhour">
  <defs>
    <linearGradient id={`${g}-tapa`} x1="0" x2="1">
      <stop offset="0" stop-color="#8A6624" />
      <stop offset="0.35" stop-color="#F7E6AE" />
      <stop offset="0.6" stop-color="#D9B565" />
      <stop offset="1" stop-color="#8A6624" />
    </linearGradient>
    <linearGradient id={`${g}-vidrio`} x1="0" x2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.55" />
      <stop offset="0.18" stop-color="#ffffff" stop-opacity="0.12" />
      <stop offset="0.8" stop-color="#ffffff" stop-opacity="0.05" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0.4" />
    </linearGradient>
    <linearGradient id={`${g}-liquido`} x1="0" x2="1">
      <stop offset="0" stop-color={tinte} stop-opacity="0.95" />
      <stop offset="0.5" stop-color={tinte} stop-opacity="0.7" />
      <stop offset="1" stop-color={tinte} stop-opacity="0.95" />
    </linearGradient>
  </defs>
  <!-- tapa dorada -->
  <rect x="17" y="2" width="26" height="38" rx="2" fill={`url(#${g}-tapa)`} />
  <rect x="17" y="34" width="26" height="3" fill="#8A6624" opacity="0.6" />
  <!-- cuello -->
  <rect x="22" y="40" width="16" height="8" fill="#C9A55C" />
  <!-- cuerpo de vidrio -->
  <rect x="10" y="48" width="40" height="118" rx="5" fill="rgba(255,255,255,0.08)" stroke="rgba(0,0,0,0.25)" stroke-width="0.8" />
  <rect x="12" y="62" width="36" height="102" rx="4" fill={`url(#${g}-liquido)`} />
  <rect x="10" y="48" width="40" height="118" rx="5" fill={`url(#${g}-vidrio)`} />
  <!-- etiqueta -->
  <rect x="14" y="96" width="32" height="30" fill="#0D0D0D" />
  <rect x="15.5" y="97.5" width="29" height="27" fill="none" stroke="#C9A55C" stroke-width="0.6" />
  <text x="30" y="110" text-anchor="middle" font-family="Bodoni Moda Variable, serif" font-size="7" fill="#E6CB82" letter-spacing="0.6">GH</text>
  <text x="30" y="120" text-anchor="middle" font-family="Jost Variable, sans-serif" font-size="4" fill="#C9A55C" letter-spacing="0.8">DECANT</text>
</svg>

<style>
  .frasquito { display: block; width: 100%; height: auto; filter: drop-shadow(0 10px 10px rgba(0, 0, 0, 0.35)); }
</style>
