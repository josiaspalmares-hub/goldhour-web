---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
---

<Base
  titulo="Goldhour · Perfumes originales y decants en Caracas"
  descripcion="Perfumes originales y sellados en Caracas: Lattafa, Lancôme, Carolina Herrera, Paco Rabanne, Valentino y más. Decants de 5 y 10 ml. Pedidos por WhatsApp."
>
  <main>
    <Hero />
    <!-- Temporal: espacio para probar la luz al bajar; aquí irá la vitrina. -->
    <section style="min-height:100svh;display:grid;place-items:center;border-top:1px solid var(--linea)">
      <p class="etiqueta">Aquí va la vitrina</p>
    </section>
  </main>
</Base>
