---
// Frasco con luz dorada (la foto hace de máscara)
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  foto: ImageMetadata;
  alt: string;
  ancho: number;
  sizes: string;
  principal?: boolean;
  clase?: string;
}
const { foto, alt, ancho, sizes, principal = false, clase = '' } = Astro.props;

// Tres tamaños en AVIF (pesa menos de la mitad) y WebP de respaldo
const anchos = [Math.round(ancho * 0.4), Math.round(ancho * 0.6), ancho];
const crear = (format: 'avif' | 'webp', quality: number) =>
  Promise.all(anchos.map((width) => getImage({ src: foto, width, format, quality })));
const avif = await crear('avif', 55);
const webp = await crear('webp', 72);
const lista = (versiones: { src: string }[]) => versiones.map((v, i) => `${v.src} ${anchos[i]}w`).join(', ');
---

<div class={`frasco-luz ${clase}`}>
  <picture>
    <source type="image/avif" srcset={lista(avif)} sizes={sizes} />
    <img
      src={webp[0].src}
      srcset={lista(webp)}
      sizes={sizes}
      width={foto.width}
      height={foto.height}
      alt={alt}
      fetchpriority={principal ? 'high' : 'low'}
      decoding="async"
    />
  </picture>
  <div class="frasco-luz__brillo" aria-hidden="true"><span class="frasco-luz__franja"></span></div>
</div>

<style>
  /* Frasco y luz con el mismo encuadre */
  .frasco-luz { position: relative; width: 100%; height: 100%; }
  .frasco-luz picture { display: contents; }
  .frasco-luz img { width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }

  .frasco-luz__brillo {
    position: absolute;
    inset: 0;
    -webkit-mask: var(--mascara) center bottom / contain no-repeat;
    mask: var(--mascara) center bottom / contain no-repeat;
    overflow: hidden;
    mix-blend-mode: screen;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s var(--ease-salida);
  }
  :global(.frasco-luz--listo) .frasco-luz__brillo { opacity: 1; }

  .frasco-luz__franja {
    position: absolute;
    top: -10%;
    bottom: -10%;
    left: 10%;
    width: 80%;
    background: linear-gradient(100deg, transparent 18%, rgba(230, 203, 130, 0.35) 38%, rgba(255, 240, 200, 0.9) 50%, rgba(230, 203, 130, 0.35) 62%, transparent 82%);
    transform: translateX(-160%);
  }

  @media (prefers-reduced-motion: reduce) {
    .frasco-luz__franja { transform: translateX(-30%); opacity: 0.6; }
  }
</style>

<script>
  // Luz al cargar la foto: la máscara usa la misma foto ya bajada
  document.querySelectorAll<HTMLElement>('.frasco-luz').forEach((frasco) => {
    const foto = frasco.querySelector('img');
    const encender = () => {
      frasco.style.setProperty('--mascara', `url("${foto!.currentSrc || foto!.src}")`);
      frasco.classList.add('frasco-luz--listo');
    };
    if (foto?.complete) encender();
    else foto?.addEventListener('load', encender, { once: true });
  });
</script>
