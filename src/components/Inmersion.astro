---
// "Entra en el frasco": al bajar, la cámara se mete en el líquido del Khamrah Qahwa; sus ingredientes (fotos reales) y sus notas
// del perfume pasan flotando, por etapas (salida, corazón, fondo). El interior ámbar se dibuja en un canvas.
import { getImage } from 'astro:assets';
import khamrah from '../assets/perfumes/khamrah-qahwa.png';
import { frascos } from '../data/perfumes';

const perfume = frascos.find((p) => p.id === 'khamrah-qahwa');
if (!perfume) throw new Error('Falta Khamrah Qahwa en el catálogo');
// Mismos tamaños y calidad que la foto de la portada: el navegador reutiliza la que ya bajó
const fotoGrande = await getImage({ src: khamrah, width: 900, format: 'webp', quality: 72 });
const fotoChica = await getImage({ src: khamrah, width: 540, format: 'webp', quality: 72 });
const etapas = [
  { nombre: 'Notas de salida', notas: perfume.ficha.salida },
  { nombre: 'Corazón', notas: perfume.ficha.corazon },
  { nombre: 'Fondo', notas: perfume.ficha.fondo },
];
// Posiciones donde aparece cada palabra (en % de la pantalla), para que no caigan todas en el centro.
const puestos = [
  [24, 34], [72, 46], [40, 68],
];
---

<section class="inmersion" aria-label={`Dentro del ${perfume.nombre}`}>
  <div class="inmersion__escena">
    <canvas class="inmersion__liquido" aria-hidden="true"></canvas>
    <canvas class="inmersion__3d" aria-hidden="true"></canvas>

    <div class="inmersion__intro">
      <p class="etiqueta">Entra en el frasco</p>
      <h2 class="inmersion__titulo">Así se siente un perfume <em>por dentro</em></h2>
    </div>

    <img
      class="inmersion__frasco"
      src={fotoGrande.src}
      srcset={`${fotoChica.src} 540w, ${fotoGrande.src} 900w`}
      sizes="(max-width: 767px) 60vw, 32vw"
      width={khamrah.width}
      height={khamrah.height}
      alt={`Frasco de ${perfume.nombre}`}
      loading="lazy"
      decoding="async"
    />

    {etapas.map((etapa, i) => (
      <div class="inmersion__etapa" data-etapa={i}>
        <p class="etiqueta inmersion__etapa-nombre">{etapa.nombre}</p>
        {etapa.notas.map((nota, j) => (
          <span class="inmersion__nota" style={`--x:${puestos[j % 3][0]}%;--y:${puestos[j % 3][1]}%`}>{nota}</span>
        ))}
      </div>
    ))}

    <div class="inmersion__final">
      <p class="inmersion__perfume">{perfume.casa} · {perfume.nombre}</p>
      <p class="inmersion__frase">Cada perfume guarda una historia.</p>
      <a class="boton boton--principal" href="#encuentra">Encuentra la tuya</a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import type { Ingredientes } from '../scripts/ingredientes3d';

  const forzarMovimiento = import.meta.env.DEV && new URLSearchParams(location.search).has('movimiento');
  const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches && !forzarMovimiento;

  const seccion = document.querySelector<HTMLElement>('.inmersion')!;
  const canvas = seccion.querySelector<HTMLCanvasElement>('.inmersion__liquido')!;
  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('El navegador no permite dibujar en canvas');

  // ---------- Interior del frasco ----------
  const movil = window.matchMedia('(max-width: 767px)').matches;
  const PROFUNDIDAD = 10;
  const estado = { avance: 0 }; // 0 = recién entramos al líquido · 1 = fondo del frasco
  let ancho = 0, alto = 0, escala = 1;

  type Particula = { x: number; y: number; z: number; r: number; sube: number; tipo: 'burbuja' | 'mota' };
  const particulas: Particula[] = Array.from({ length: movil ? 70 : 140 }, (_, i) => ({
    x: (Math.random() * 2 - 1) * 1.4,
    y: (Math.random() * 2 - 1) * 1.2,
    z: Math.random() * PROFUNDIDAD,
    r: 0.4 + Math.random() * 1.1,
    sube: 0.04 + Math.random() * 0.12,
    tipo: i % 3 === 0 ? 'mota' : 'burbuja',
  }));

  function medir() {
    escala = Math.min(window.devicePixelRatio || 1, movil ? 1 : 1.5);
    ancho = canvas.clientWidth;
    alto = canvas.clientHeight;
    canvas.width = Math.round(ancho * escala);
    canvas.height = Math.round(alto * escala);
  }

  function fondo(t: number) {
    // Del ámbar claro (recién entramos) a un café profundo (el fondo del perfume)
    const a = estado.avance;
    const g = ctx!.createRadialGradient(ancho * 0.5, alto * 0.28, 0, ancho * 0.5, alto * 0.5, Math.max(ancho, alto) * 0.85);
    g.addColorStop(0, `hsl(${38 - a * 8} 85% ${56 - a * 22}%)`);
    g.addColorStop(0.55, `hsl(${32 - a * 6} 80% ${30 - a * 14}%)`);
    g.addColorStop(1, `hsl(24 70% ${10 - a * 4}%)`);
    ctx!.fillStyle = g;
    ctx!.fillRect(0, 0, ancho, alto);

    // Rayos de luz que bajan desde la superficie y se mecen despacio
    ctx!.globalCompositeOperation = 'lighter';
    for (let i = 0; i < 5; i++) {
      const giro = Math.sin(t * 0.00025 + i * 1.7) * 0.12 + (i - 2) * 0.22;
      ctx!.save();
      ctx!.translate(ancho * 0.5, -alto * 0.1);
      ctx!.rotate(giro);
      const rayo = ctx!.createLinearGradient(0, 0, 0, alto * 1.2);
      rayo.addColorStop(0, `rgba(255, 228, 160, ${0.13 * (1 - a * 0.6)})`);
      rayo.addColorStop(1, 'rgba(255, 228, 160, 0)');
      ctx!.fillStyle = rayo;
      const w = ancho * (0.05 + (i % 2) * 0.04);
      ctx!.fillRect(-w / 2, 0, w, alto * 1.2);
      ctx!.restore();
    }
    ctx!.globalCompositeOperation = 'source-over';
  }

  function particulasDibujo(dt: number) {
    const camara = estado.avance * PROFUNDIDAD * 2.2;
    const base = Math.min(ancho, alto) * 0.02;
    for (const p of particulas) {
      p.y -= p.sube * dt * 0.001;
      if (p.y < -1.3) p.y = 1.3;
      const z = ((((p.z - camara) % PROFUNDIDAD) + PROFUNDIDAD) % PROFUNDIDAD) + 0.15;
      const f = 1.1 / z; // más cerca = más grande
      const x = ancho / 2 + p.x * f * ancho * 0.5;
      const y = alto / 2 + p.y * f * alto * 0.5;
      const r = p.r * f * base;
      if (x < -r || x > ancho + r || y < -r || y > alto + r) continue;
      // Se desvanecen al llegar muy cerca o muy lejos, para que no "salten"
      const alfa = Math.min(1, z / 0.8) * Math.min(1, (PROFUNDIDAD - z) / 3);
      if (p.tipo === 'mota') {
        const g = ctx!.createRadialGradient(x, y, 0, x, y, r * 1.6);
        g.addColorStop(0, `rgba(255, 214, 140, ${0.5 * alfa})`);
        g.addColorStop(1, 'rgba(255, 214, 140, 0)');
        ctx!.fillStyle = g;
        ctx!.fillRect(x - r * 1.6, y - r * 1.6, r * 3.2, r * 3.2);
      } else {
        ctx!.beginPath();
        ctx!.arc(x, y, r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(255, 236, 200, ${0.06 * alfa})`;
        ctx!.fill();
        ctx!.lineWidth = Math.max(0.6, r * 0.08);
        ctx!.strokeStyle = `rgba(255, 240, 210, ${0.45 * alfa})`;
        ctx!.stroke();
        ctx!.beginPath();
        ctx!.arc(x - r * 0.35, y - r * 0.35, r * 0.22, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(255, 255, 255, ${0.7 * alfa})`;
        ctx!.fill();
      }
    }
  }

  // Ingredientes en 3D: Three.js pesa, así que se descarga solo cuando la sección se acerca
  const lienzo3d = seccion.querySelector<HTMLCanvasElement>('.inmersion__3d')!;
  let ingredientes: Ingredientes | null = null;
  async function cargarIngredientes() {
    const { crearIngredientes } = await import('../scripts/ingredientes3d');
    try {
      ingredientes = crearIngredientes(lienzo3d, movil);
    } catch (error) {
      // Sin WebGL (equipos muy viejos) queda el interior en 2D, que también funciona solo
      console.error('No se pudo iniciar el 3D de ingredientes:', error);
      lienzo3d.remove();
      return;
    }
    ingredientes.medir();
  }

  let ultimo = 0;
  let cuadro = 0;
  function dibujar(t: number) {
    const dt = ultimo ? Math.min(t - ultimo, 50) : 16;
    ultimo = t;
    ctx!.setTransform(escala, 0, 0, escala, 0, 0);
    fondo(t);
    particulasDibujo(dt);
    ingredientes?.dibujar(estado.avance, t);
    cuadro = requestAnimationFrame(dibujar);
  }

  function encender() {
    if (!cuadro) { ultimo = 0; cuadro = requestAnimationFrame(dibujar); }
  }
  function apagar() {
    cancelAnimationFrame(cuadro);
    cuadro = 0;
  }

  medir();
  window.addEventListener('resize', () => { medir(); ingredientes?.medir(); });

  if (reducir) {
    // Sin movimiento: una sola imagen del interior y todo el contenido visible, sin fijar la pantalla.
    seccion.classList.add('inmersion--quieta');
    const pintarQuieto = () => {
      medir();
      ctx.setTransform(escala, 0, 0, escala, 0, 0);
      fondo(0);
      particulasDibujo(0);
    };
    // Se vuelve a pintar si cambia el alto (por ejemplo cuando termina de cargar la foto)
    new ResizeObserver(pintarQuieto).observe(canvas);
  } else {
    // Solo se dibuja mientras la sección está en pantalla
    new IntersectionObserver(([e]) => (e.isIntersecting ? encender() : apagar()), { rootMargin: '100px' }).observe(seccion);
    // Se espera a que la portada termine de cargar, para no quitarle velocidad a lo primero que se ve
    const vigilarCercania = () => {
      const cerca = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        cerca.disconnect();
        cargarIngredientes();
      }, { rootMargin: '1200px' });
      cerca.observe(seccion);
    };
    if (document.readyState === 'complete') vigilarCercania();
    else window.addEventListener('load', vigilarCercania, { once: true });
    document.addEventListener('visibilitychange', () => (document.hidden ? apagar() : seccion.getBoundingClientRect().bottom > 0 && encender()));

    gsap.registerPlugin(ScrollTrigger);
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: seccion, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
    });
    // 1. La cámara se acerca al líquido del frasco
    tl.to('.inmersion__intro', { opacity: 0, y: -40, duration: 0.9 }, 0.2)
      .fromTo('.inmersion__frasco', { scale: 1 }, { scale: 16, duration: 3.4, ease: 'power3.in' }, 0)
      .to('.inmersion__liquido', { opacity: 1, duration: 1 }, 1.7)
      .to('.inmersion__frasco', { opacity: 0, filter: 'blur(10px)', duration: 0.7 }, 2.2)
      .fromTo('.inmersion__3d', { opacity: 0 }, { opacity: 1, duration: 0.8 }, 2.5)
      .to(estado, { avance: 1, duration: 7 }, 3);

    // 2. Las notas pasan hacia la cámara, una etapa tras otra
    seccion.querySelectorAll<HTMLElement>('.inmersion__etapa').forEach((etapa, i) => {
      const inicio = 3.5 + i * 1.9;
      tl.fromTo(etapa.querySelector('.inmersion__etapa-nombre'), { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.4 }, inicio)
        .to(etapa.querySelector('.inmersion__etapa-nombre'), { opacity: 0, duration: 0.4 }, inicio + 1.5);
      etapa.querySelectorAll('.inmersion__nota').forEach((nota, j) => {
        const t = inicio + j * 0.3;
        tl.fromTo(nota, { opacity: 0, scale: 0.35, filter: 'blur(6px)' }, { opacity: 1, scale: 1, filter: 'blur(0px)', duration: 0.7 }, t)
          .to(nota, { opacity: 0, scale: 2.6, filter: 'blur(10px)', duration: 0.7, ease: 'power1.in' }, t + 0.8);
      });
    });

    // 3. Cierre
    tl.fromTo('.inmersion__final', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.8 }, 9.3).to({}, { duration: 0.5 });
  }
</script>

<style>
  .inmersion { position: relative; height: 520vh; background: var(--negro); }
  .inmersion__escena { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; display: grid; place-items: center; }

  .inmersion__liquido,
  .inmersion__3d { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; }
  .inmersion--quieta .inmersion__3d { display: none; }

  .inmersion__intro { position: absolute; top: 11%; left: 0; right: 0; text-align: center; padding-inline: var(--e-5); z-index: 2; }
  .inmersion__titulo { font-family: var(--serif); font-size: var(--t-h2); font-weight: 500; color: var(--blanco); line-height: 1.05; margin: var(--e-3) auto 0; max-width: 16ch; }
  .inmersion__titulo em { color: var(--oro-claro); }

  .inmersion :global(.inmersion__frasco) {
    position: relative;
    height: 50svh;
    width: auto;
    margin-top: 30svh;
    transform-origin: 50% 51%; /* el líquido ámbar, encima de la etiqueta */
    will-change: transform;
    filter: drop-shadow(0 40px 60px rgba(0, 0, 0, 0.6));
  }

  .inmersion__etapa { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  .inmersion__etapa-nombre { position: absolute; top: 12%; left: 0; right: 0; text-align: center; color: rgba(255, 244, 220, 0.85); opacity: 0; }
  .inmersion__nota {
    position: absolute;
    left: calc(50% + (var(--x) - 50%) * var(--abre, 1));
    top: var(--y);
    translate: -50% -50%;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.75rem, 1.5rem + 5vw, 6.5rem);
    color: #fff6e6;
    text-shadow: 0 4px 30px rgba(60, 25, 0, 0.55);
    white-space: nowrap;
    opacity: 0;
    will-change: transform, opacity, filter;
  }

  .inmersion__final { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: var(--e-4); text-align: center; padding-inline: var(--e-5); opacity: 0; z-index: 4; }
  .inmersion__perfume { margin: 0; font-size: 0.75rem; letter-spacing: var(--tracking-etiqueta); text-transform: uppercase; color: rgba(255, 244, 220, 0.8); }
  .inmersion__frase { margin: 0 0 var(--e-3); font-family: var(--serif); font-size: var(--t-h2); line-height: 1.05; color: var(--blanco); max-width: 14ch; text-shadow: 0 4px 30px rgba(40, 15, 0, 0.6); }

  @media (max-width: 767px) {
    .inmersion { height: 440vh; }
    .inmersion :global(.inmersion__frasco) { height: 44svh; margin-top: 28svh; }
    .inmersion__nota { --abre: 0.3; font-size: 2.5rem; }
  }

  /* Sin movimiento: se muestra todo de una vez, sin fijar la pantalla */
  .inmersion--quieta { height: auto; }
  .inmersion--quieta .inmersion__escena { position: relative; height: auto; min-height: 100svh; padding-block: var(--e-9); gap: var(--e-6); }
  .inmersion--quieta .inmersion__liquido { opacity: 1; }
  .inmersion--quieta .inmersion__intro .etiqueta,
  .inmersion--quieta .inmersion__titulo em { color: #fff6e6; }
  .inmersion--quieta .inmersion__intro,
  .inmersion--quieta .inmersion__etapa,
  .inmersion--quieta .inmersion__final { position: relative; inset: auto; top: auto; opacity: 1; }
  .inmersion--quieta :global(.inmersion__frasco) { margin-top: 0; height: 40svh; }
  .inmersion--quieta .inmersion__etapa { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--e-3); }
  .inmersion--quieta .inmersion__etapa-nombre { position: static; width: 100%; opacity: 1; }
  .inmersion--quieta .inmersion__nota { position: static; translate: none; opacity: 1; font-size: 2rem; }
</style>
