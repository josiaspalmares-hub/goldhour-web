---
// Pantalla de entrada: solo CSS, ~1,2 s, una vez por visita
import monogramaSvg from '../assets/marca/monograma-G-oro.svg?raw';

// pathLength=1: animar el trazo sin conocer su largo
const monograma = monogramaSvg.replace('<path ', '<path pathLength="1" ');
---

<!-- Ya vista: se marca antes de pintar (archivo aparte por la CSP) -->
<script is:inline src="/entrada.js"></script>

<div class="cargador" aria-hidden="true">
  <div class="cargador__g" set:html={monograma} />
</div>

<style>
  .cargador {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--negro);
    pointer-events: none;
    animation: cargador-abre 0.55s var(--ease-salida) 0.85s forwards;
  }
  :global(.entrada-vista) .cargador { display: none; }
  .cargador__g { width: min(34vw, 150px); }
  .cargador__g :global(svg) { display: block; width: 100%; height: auto; overflow: visible; }
  /* Trazo y relleno de la G */
  .cargador__g :global(path) {
    stroke: var(--oro);
    stroke-width: 1.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    fill-opacity: 0;
    animation: cargador-traza 0.7s ease-in-out forwards, cargador-rellena 0.35s ease-out 0.5s forwards;
  }
  .cargador__g :global(rect) { transform-box: fill-box; transform-origin: center; transform: scaleX(0); animation: cargador-linea 0.4s var(--ease-salida) 0.45s forwards; }

  @keyframes cargador-traza { to { stroke-dashoffset: 0; } }
  @keyframes cargador-rellena { to { fill-opacity: 1; stroke-opacity: 0; } }
  @keyframes cargador-linea { to { transform: scaleX(1); } }
  @keyframes cargador-abre { to { opacity: 0; visibility: hidden; } }

  @media (prefers-reduced-motion: reduce) {
    .cargador { display: none; }
  }
</style>
