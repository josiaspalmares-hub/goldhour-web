---
import logo from '../assets/marca/logo-principal-oro.svg';
import { WHATSAPP, INSTAGRAM } from '../data/perfumes';

// El pie apunta a la portada cuando se usa desde las páginas legales.
interface Props {
  base?: string;
}
const { base = '' } = Astro.props;
const anio = new Date().getFullYear();
const redes = [
  { texto: 'Instagram', href: `https://www.instagram.com/${INSTAGRAM}/` },
  { texto: 'Facebook', href: 'https://www.facebook.com/p/Gold-Hour-61595622513241/' },
  { texto: 'WhatsApp 0412-610-95-80', href: `https://wa.me/${WHATSAPP}` },
];
const secciones = [
  { texto: 'Vitrina', href: `${base}#vitrina` },
  { texto: 'Decants', href: `${base}#decants` },
  { texto: 'Cómo comprar', href: `${base}#como-comprar` },
  { texto: 'Preguntas', href: `${base}#preguntas` },
];
const legales = [
  { texto: 'Privacidad', href: '/privacidad' },
  { texto: 'Cambios y devoluciones', href: '/cambios' },
  { texto: 'Créditos de fotos', href: '/creditos' },
  { texto: 'Acceso socios', href: '/panel' },
];
---

<footer class="pie">
  <div class="contenedor pie__grid">
    <div class="pie__marca">
      <img src={logo.src} width="240" height={Math.round((240 * logo.height) / logo.width)} alt="Goldhour · Maison de Parfums" loading="lazy" />
      <p>Perfumes originales y sellados en Caracas. Decants para probar antes del frasco.</p>
    </div>
    <nav aria-label="Secciones">
      <p class="etiqueta">La tienda</p>
      <ul role="list">{secciones.map((s) => <li><a href={s.href}>{s.texto}</a></li>)}</ul>
    </nav>
    <div>
      <p class="etiqueta">Escríbenos</p>
      <ul role="list">{redes.map((r) => <li><a href={r.href} target="_blank" rel="noopener">{r.texto}</a></li>)}</ul>
    </div>
  </div>
  <div class="contenedor pie__base">
    <p>© {anio} Goldhour · Caracas, Venezuela</p>
    <ul role="list">{legales.map((l) => <li><a href={l.href}>{l.texto}</a></li>)}</ul>
  </div>
</footer>

<style>
  .pie { border-top: 1px solid var(--linea); padding-block: var(--e-8) var(--e-6); background: #090909; }
  .pie__grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: var(--e-7); }
  .pie__marca img { width: 240px; height: auto; margin-bottom: var(--e-4); }
  .pie__marca p { margin: 0; color: var(--texto-2); max-width: 28ch; font-size: 0.9375rem; }
  .pie ul { list-style: none; margin: var(--e-3) 0 0; padding: 0; display: grid; gap: var(--e-1); }
  .pie a { color: var(--texto); text-decoration: none; display: inline-block; padding-block: var(--e-2); }
  .pie a:hover { color: var(--oro-claro); }
  .pie__base { margin-top: var(--e-7); padding-top: var(--e-5); border-top: 1px solid var(--linea); display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--e-3); font-size: 0.8125rem; color: var(--texto-2); }
  .pie__base p { margin: 0; align-self: center; }
  .pie__base ul { margin: 0; display: flex; gap: var(--e-5); }
  .pie__base a { color: var(--texto-2); }

  @media (max-width: 767px) {
    .pie__grid { grid-template-columns: 1fr 1fr; gap: var(--e-6); }
    .pie__marca { grid-column: 1 / -1; }
    .pie__base { flex-direction: column; }
  }
</style>
