---
import { Image } from 'astro:assets';
import Ficha from './Ficha.astro';
import Frasquitos from './Frasquitos.astro';
import SelectorTamano from './SelectorTamano.astro';
import { decants } from '../data/perfumes';
import { fotoDe } from '../data/fotos';
---

<section id="decants" class="decants" aria-labelledby="decants-titulo">
  <div class="contenedor">
    <header class="decants__cabeza">
      <p class="etiqueta">Decants</p>
      <h2 id="decants-titulo" class="decants__titulo">Pruébalo antes de comprar el frasco</h2>
      <p class="decants__texto">
        Envasamos el perfume original en un atomizador de vidrio de Goldhour. 5 ml dan para unas 80 a 90 aplicaciones:
        suficiente para saber cómo te dura y si es para ti.
      </p>
    </header>

    <ul class="decants__lista" role="list">
      {decants.map((p) => (
        <li class="decant" id={p.id} data-producto data-elegido={p.tamanos[0].etiqueta}>
          <span class="decant__foto">
            <Image class="decant__frasco" src={fotoDe(p.foto ?? p.id)} alt="" width={420} format="webp" loading="lazy" />
            <span class="decant__frasquitos"><Frasquitos /></span>
          </span>

          <div class="decant__info">
            <p class="etiqueta">{p.casa}</p>
            <!-- Toda la tarjeta abre la ficha, menos tamaños y "Agregar" -->
            <h3 class="decant__nombre"><button type="button" class="decant__abrir" data-abrir-ficha={p.id} aria-label={`${p.nombre}: ver la ficha`}>{p.nombre}</button></h3>
            <p class="decant__frase">{p.frase}</p>
            <SelectorTamano perfume={p} grupo={`tam-${p.id}`} />
            <div class="decant__acciones">
              <button type="button" class="boton boton--oscuro" data-agregar data-id={p.id} data-nombre={p.nombre} data-casa={p.casa}>
                <span data-texto>Agregar</span>
              </button>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>

  {decants.map((p) => (
    <Ficha perfume={p} tema="marfil">
      <div class="ficha-decant" data-producto>
        <SelectorTamano perfume={p} grupo={`ficha-tam-${p.id}`} />
        <button type="button" class="boton boton--oscuro" data-agregar data-id={p.id} data-nombre={p.nombre} data-casa={p.casa}>
          <span data-texto>Agregar al pedido</span>
        </button>
      </div>
    </Ficha>
  ))}
</section>

<style>
  .decants {
    background: var(--marfil);
    color: var(--tinta);
    padding-block: var(--e-9);
    scroll-margin-top: 72px;
  }
  .decants .etiqueta { color: var(--oro-oscuro); }

  .decants__cabeza { max-width: 40rem; margin-bottom: var(--e-8); }
  .decants__titulo { font-family: var(--serif); font-size: var(--t-h2); font-weight: 500; line-height: 1.05; margin: var(--e-3) 0 var(--e-4); color: var(--tinta); }
  .decants__texto { margin: 0; font-size: 1.0625rem; color: #4a4540; max-width: 34rem; }

  .decants__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--e-8) var(--e-7);
  }

  /* Tarjeta ancha */
  .decant { position: relative; display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--e-5); align-items: center; cursor: pointer; }
  .decant__abrir { all: unset; cursor: pointer; transition: color 0.2s; }
  .decant__abrir::after { content: ''; position: absolute; inset: 0; border-radius: var(--radio); }
  .decant__abrir:focus-visible::after { outline: 2px solid var(--oro-oscuro); outline-offset: 4px; }
  .decant:hover .decant__abrir { color: var(--oro-oscuro); }
  .decant :global(.selector), .decant__acciones { position: relative; z-index: 1; cursor: auto; }

  .decant__foto {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    border-radius: var(--radio);
    background: radial-gradient(70% 28% at 50% 90%, rgba(138, 102, 36, 0.18), transparent 70%), #e9e1d2;
    overflow: hidden;
  }
  .decant__foto :global(.decant__frasco) {
    position: absolute;
    inset: 10% 26% 12% 8%;
    width: 66%;
    height: 78%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 16px 14px rgba(0, 0, 0, 0.28));
    transition: transform 0.4s var(--ease-salida), translate 0.55s var(--ease-salida);
  }
  /* Frasquito del tamaño elegido */
  .decant__frasquitos { position: absolute; right: 6%; bottom: 12%; width: 16%; height: 66%; }
  .decant__frasquitos :global(.frasquitos) { inset: 0; }
  /* Frasco completo: perfume al centro */
  .decant[data-elegido^='Frasco'] .decant__foto :global(.decant__frasco) { translate: 13.6% 0; }
  .decant:hover .decant__foto :global(.decant__frasco) { transform: translateY(-4px); }
  @media (prefers-reduced-motion: reduce) {
    .decant:hover .decant__foto :global(.decant__frasco) { transform: none; }
    .decant__foto :global(.decant__frasco) { transition: none; }
  }

  .decant__nombre { font-family: var(--serif); font-size: 1.625rem; font-weight: 500; line-height: 1.15; margin: var(--e-1) 0 var(--e-2); color: var(--tinta); }
  .decant__frase { margin: 0 0 var(--e-4); font-size: 0.9375rem; color: #4a4540; }

  .decant__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-4); margin-top: var(--e-4); }

  .ficha-decant { display: grid; gap: var(--e-4); }
  .ficha-decant .boton { justify-self: start; }

  @media (max-width: 899px) {
    .decants__lista { grid-template-columns: 1fr; gap: var(--e-7); }
  }
  @media (max-width: 767px) {
    .decants { padding-block: var(--e-8); }
    .decants__cabeza { margin-bottom: var(--e-6); }
    .decant { grid-template-columns: 1fr; }
    .decant__foto { aspect-ratio: 5 / 4; }
    .decant__foto :global(.decant__frasco) { inset: 10% 30% 12% 20%; width: 50%; }
    .decant[data-elegido^='Frasco'] .decant__foto :global(.decant__frasco) { translate: 10% 0; }
    .decant__frasquitos { right: 16%; width: 10%; height: 56%; }
    .ficha-decant {
      position: sticky;
      bottom: 0;
      margin: 0 calc(var(--e-5) * -1) calc(var(--e-5) * -1);
      padding: var(--e-3) var(--e-5);
      background: var(--fondo-ficha);
      border-top: 1px solid var(--linea);
    }
    .ficha-decant .boton { justify-self: stretch; }
  }
</style>
