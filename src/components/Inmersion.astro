---
// Entra en el frasco: un video por etapa (Pexels), cargados de a uno; verticales en el teléfono
import { getImage } from 'astro:assets';
import elixir from '../assets/perfumes/le-male-elixir.png';
import { WHATSAPP } from '../data/perfumes';

const perfume = {
  slug: 'jean-paul-gaultier-le-male-elixir-eau-de-parfum-125-ml',
  casa: 'Jean Paul Gaultier',
  nombre: 'Le Male Elixir',
  nombreCatalogo: 'Jean Paul Gaultier Le Male Elixir Eau de Parfum 125 ml',
  precio: 145, // se actualiza con el catálogo al cargar la sección
};
const fotoGrande = await getImage({ src: elixir, width: 900, format: 'webp', quality: 78 });
const fotoChica = await getImage({ src: elixir, width: 540, format: 'webp', quality: 78 });

// Cada etapa: su video y las notas que pasan flotando
const escenas = [
  { video: 'liquido' }, // al entrar en el frasco
  { video: 'lavanda', nombre: 'Notas de salida', notas: ['Lavanda', 'Menta'] },
  { video: 'vainilla', nombre: 'Corazón', notas: ['Vainilla', 'Benjuí'] },
  { video: 'miel', nombre: 'Fondo', notas: ['Miel', 'Haba tonka', 'Tabaco'] },
];
const etapas = escenas.filter((e) => e.nombre);
// Posiciones donde aparece cada palabra (en % de la pantalla), para que no caigan todas en el centro.
const puestos = [[26, 36], [70, 50], [42, 68]];
const videoDe = (n: string) => `/media/elixir/${n}`;
---

<section class="inmersion" aria-label={`Dentro del ${perfume.nombre}`} data-slug={perfume.slug} data-whatsapp={WHATSAPP}>
  <div class="inmersion__escena">
    <div class="inmersion__videos" aria-hidden="true">
      {escenas.map((e, i) => (
        <video
          class="inmersion__video"
          data-escena={i}
          data-pc={`${videoDe(e.video)}-pc.mp4`}
          data-movil={`${videoDe(e.video)}-movil.mp4`}
          data-cartel={`${videoDe(e.video)}-cartel.webp`}
          muted
          loop
          playsinline
          preload="none"
        ></video>
      ))}
    </div>
    <div class="inmersion__velo" aria-hidden="true"></div>
    <div class="inmersion__oscuro" aria-hidden="true"></div>
    <canvas class="inmersion__polvo" aria-hidden="true"></canvas>

    <div class="inmersion__intro">
      <p class="etiqueta">Entra en el frasco</p>
      <h2 class="inmersion__titulo">Así se siente un perfume <em>por dentro</em></h2>
    </div>

    <img
      class="inmersion__frasco"
      data-src={fotoGrande.src}
      data-srcset={`${fotoChica.src} 540w, ${fotoGrande.src} 900w`}
      sizes="(max-width: 767px) 50vw, 26vw"
      width={elixir.width}
      height={elixir.height}
      alt={`Frasco de ${perfume.nombre}`}
      loading="lazy"
      decoding="async"
    />

    {etapas.map((etapa, i) => (
      <div class="inmersion__etapa" data-etapa={i}>
        <p class="etiqueta inmersion__etapa-nombre">{etapa.nombre}</p>
        {etapa.notas!.map((nota, j) => (
          <span class="inmersion__nota" style={`--x:${puestos[j % 3][0]}%;--y:${puestos[j % 3][1]}%`}>{nota}</span>
        ))}
      </div>
    ))}

    <div class="inmersion__final">
      <p class="inmersion__perfume">{perfume.casa} · {perfume.nombre}</p>
      <p class="inmersion__frase">Miel, lavanda y vainilla que se quedan en la piel.</p>
      <p class="inmersion__precio"><span data-elixir-precio>${perfume.precio}</span> · <span data-elixir-estado>por encargo, llega en 3 a 5 días</span></p>
      <div class="inmersion__acciones">
        <button
          type="button"
          class="boton boton--principal"
          data-agregar
          data-id={`cat-${perfume.slug}`}
          data-nombre={perfume.nombreCatalogo}
          data-casa={perfume.casa}
          data-tamano="Frasco · por encargo (3 a 5 días)"
          data-precio={perfume.precio}
        ><span data-texto>Agregar al pedido</span></button>
        <a class="boton boton--secundario" href="#encuentra">Encuentra el tuyo</a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { leerCatalogo } from '../scripts/supabase';

  const forzarMovimiento = import.meta.env.DEV && new URLSearchParams(location.search).has('movimiento');
  const reducir = window.matchMedia('(prefers-reduced-motion: reduce)').matches && !forzarMovimiento;
  const movil = window.matchMedia('(max-width: 767px)').matches;

  const seccion = document.querySelector<HTMLElement>('.inmersion')!;
  const videos = [...seccion.querySelectorAll<HTMLVideoElement>('.inmersion__video')];
  const canvas = seccion.querySelector<HTMLCanvasElement>('.inmersion__polvo')!;
  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('El navegador no permite dibujar en canvas');

  // ---------- Videos: solo corre el que se ve ----------
  const cargarVideo = (v: HTMLVideoElement | undefined) => {
    if (!v || v.getAttribute('src')) return;
    v.src = movil ? v.dataset.movil! : v.dataset.pc!;
    v.preload = 'auto';
  };
  let activo = -1;
  function mostrarVideo(i: number) {
    if (i === activo) return;
    activo = i;
    cargarVideo(videos[i]);
    cargarVideo(videos[i + 1]);
    videos.forEach((v, k) => {
      if (k === i) v.play().catch((e: DOMException) => { if (e.name !== 'AbortError' && e.name !== 'NotAllowedError') throw e; });
      else v.pause();
    });
  }

  // ---------- Polvo dorado ----------
  let ancho = 0, alto = 0, escala = 1;
  const motas = Array.from({ length: movil ? 40 : 80 }, () => ({
    x: Math.random(), y: Math.random(), r: 0.6 + Math.random() * 1.8, sube: 0.008 + Math.random() * 0.025, fase: Math.random() * 6.28,
  }));
  function medir() {
    escala = Math.min(window.devicePixelRatio || 1, movil ? 1 : 1.5);
    ancho = canvas.clientWidth; alto = canvas.clientHeight;
    canvas.width = Math.round(ancho * escala); canvas.height = Math.round(alto * escala);
  }
  let ultimo = 0, cuadro = 0;
  function dibujar(t: number) {
    const dt = ultimo ? Math.min(t - ultimo, 50) / 1000 : 0.016;
    ultimo = t;
    ctx!.setTransform(escala, 0, 0, escala, 0, 0);
    ctx!.clearRect(0, 0, ancho, alto);
    ctx!.globalCompositeOperation = 'lighter';
    for (const m of motas) {
      m.y -= m.sube * dt; if (m.y < -0.05) { m.y = 1.05; m.x = Math.random(); }
      const x = (m.x + Math.sin(t * 0.0004 + m.fase) * 0.01) * ancho, y = m.y * alto;
      const brillo = 0.35 + 0.35 * Math.sin(t * 0.002 + m.fase);
      const r = m.r * (movil ? 1.2 : 1.6);
      const g = ctx!.createRadialGradient(x, y, 0, x, y, r * 3);
      g.addColorStop(0, `rgba(255, 220, 150, ${brillo})`);
      g.addColorStop(1, 'rgba(255, 200, 120, 0)');
      ctx!.fillStyle = g;
      ctx!.fillRect(x - r * 3, y - r * 3, r * 6, r * 6);
    }
    ctx!.globalCompositeOperation = 'source-over';
    cuadro = requestAnimationFrame(dibujar);
  }
  const encender = () => { if (!cuadro) { ultimo = 0; cuadro = requestAnimationFrame(dibujar); } };
  const apagar = () => { cancelAnimationFrame(cuadro); cuadro = 0; videos.forEach((v) => v.pause()); activo = -1; };

  // ---------- Precio del catálogo (si falla, queda el escrito) ----------
  async function actualizarPrecio() {
    let p;
    try {
      p = (await leerCatalogo()).find((x) => x.slug === seccion.dataset.slug);
    } catch (error) {
      console.warn('No se pudo actualizar el precio del Le Male Elixir:', error);
      return;
    }
    if (!p) return;
    const boton = seccion.querySelector<HTMLButtonElement>('[data-agregar]')!;
    seccion.querySelector('[data-elixir-precio]')!.textContent = `$${Number(p.precio_usd)}`;
    boton.dataset.precio = String(Number(p.precio_usd));
    const disponible = p.estado === 'disponible';
    seccion.querySelector('[data-elixir-estado]')!.textContent = disponible ? 'disponible ya en Caracas' : p.estado === 'agotado' ? 'agotado por ahora' : 'por encargo, llega en 3 a 5 días';
    boton.dataset.tamano = disponible ? 'Frasco' : 'Frasco · por encargo (3 a 5 días)';
    boton.hidden = p.estado === 'agotado';
  }

  medir();
  window.addEventListener('resize', medir);

  // Carteles y frasco: se piden al acercarse, no al abrir la página
  const fotoFrasco = seccion.querySelector<HTMLImageElement>('.inmersion__frasco')!;
  const ponerFotos = () => {
    videos.forEach((v) => { v.poster = v.dataset.cartel!; });
    fotoFrasco.srcset = fotoFrasco.dataset.srcset!;
    fotoFrasco.src = fotoFrasco.dataset.src!;
  };
  const fotosCerca = new IntersectionObserver(([e]) => {
    if (!e.isIntersecting) return;
    fotosCerca.disconnect();
    ponerFotos();
  }, { rootMargin: '1200px 0px' });
  // Después de que cargue la portada
  if (document.readyState === 'complete') fotosCerca.observe(seccion);
  else window.addEventListener('load', () => fotosCerca.observe(seccion), { once: true });

  if (reducir) {
    // Sin movimiento: todo visible, sin videos
    seccion.classList.add('inmersion--quieta');
    actualizarPrecio();
  } else {
    new IntersectionObserver(([e]) => (e.isIntersecting ? encender() : apagar()), { rootMargin: '100px' }).observe(seccion);
    // Primer video al acercarse
    const vigilarCercania = () => {
      const cerca = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        cerca.disconnect();
        cargarVideo(videos[0]);
        actualizarPrecio();
      }, { rootMargin: '1000px' });
      cerca.observe(seccion);
    };
    if (document.readyState === 'complete') vigilarCercania();
    else window.addEventListener('load', vigilarCercania, { once: true });
    document.addEventListener('visibilitychange', () => { if (document.hidden) apagar(); });

    gsap.registerPlugin(ScrollTrigger);
    const capas = videos.map(() => ({ o: 0 }));
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: seccion, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
      onUpdate: () => {
        // Corre el video más visible
        let mayor = 0, cual = -1;
        capas.forEach((c, i) => { videos[i].style.opacity = String(c.o); if (c.o > mayor) { mayor = c.o; cual = i; } });
        if (cual >= 0 && mayor > 0.05 && cuadro) mostrarVideo(cual);
      },
    });

    // 1. Entrar al frasco
    tl.to('.inmersion__intro', { opacity: 0, y: -40, duration: 0.9 }, 0.2)
      .fromTo('.inmersion__frasco', { scale: 1 }, { scale: 14, duration: 3.2, ease: 'power3.in' }, 0)
      .to(capas[0], { o: 1, duration: 1 }, 1.6)
      .to('.inmersion__frasco', { opacity: 0, filter: 'blur(10px)', duration: 0.7 }, 2.1);

    // 2. Etapas
    seccion.querySelectorAll<HTMLElement>('.inmersion__etapa').forEach((etapa, i) => {
      const inicio = 3.4 + i * 2;
      tl.to(capas[i + 1], { o: 1, duration: 0.6 }, inicio - 0.3)
        .set(capas[i], { o: 0 }, inicio + 0.3)
        .fromTo(etapa.querySelector('.inmersion__etapa-nombre'), { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.4 }, inicio)
        .to(etapa.querySelector('.inmersion__etapa-nombre'), { opacity: 0, duration: 0.4 }, inicio + 1.6);
      etapa.querySelectorAll('.inmersion__nota').forEach((nota, j) => {
        const t = inicio + j * 0.3;
        tl.fromTo(nota, { opacity: 0, scale: 0.35, filter: 'blur(6px)' }, { opacity: 1, scale: 1, filter: 'blur(0px)', duration: 0.7 }, t)
          .to(nota, { opacity: 0, scale: 2.4, filter: 'blur(10px)', duration: 0.7, ease: 'power1.in' }, t + 0.9);
      });
    });

    // 3. Cierre
    tl.to('.inmersion__oscuro', { opacity: 1, duration: 0.8 }, 9.5)
      .fromTo('.inmersion__final', { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.8 }, 9.7)
      .to({}, { duration: 0.6 });
  }
</script>

<style>
  .inmersion { position: relative; height: 560vh; background: var(--negro); }
  .inmersion__escena { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; display: grid; place-items: center; }

  .inmersion__videos { position: absolute; inset: 0; background: radial-gradient(80% 70% at 50% 45%, #3a2410, #0d0d0d 75%); }
  .inmersion__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; }
  /* Viñeta */
  .inmersion__velo {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(120% 90% at 50% 50%, transparent 40%, rgba(13, 13, 13, 0.75) 100%), rgba(13, 13, 13, 0.18);
  }
  .inmersion__oscuro { position: absolute; inset: 0; pointer-events: none; opacity: 0; background: radial-gradient(70% 60% at 50% 50%, rgba(13, 13, 13, 0.72), rgba(13, 13, 13, 0.9)); }
  .inmersion__polvo { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }

  .inmersion__intro { position: absolute; top: 11%; left: 0; right: 0; text-align: center; padding-inline: var(--e-5); z-index: 2; }
  .inmersion__titulo { font-family: var(--serif); font-size: var(--t-h2); font-weight: 500; color: var(--blanco); line-height: 1.05; margin: var(--e-3) auto 0; max-width: 16ch; }
  .inmersion__titulo em { color: var(--oro); }

  .inmersion__frasco {
    position: relative;
    z-index: 1;
    height: 52svh;
    width: auto;
    margin-top: 30svh;
    transform-origin: 50% 46%; /* el pecho del frasco, donde se ve el líquido */
    will-change: transform;
    filter: drop-shadow(0 40px 60px rgba(0, 0, 0, 0.7)) drop-shadow(0 0 60px rgba(201, 165, 92, 0.25));
  }

  .inmersion__etapa { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  /* Nombre de la etapa */
  .inmersion__etapa-nombre {
    position: absolute; top: 12%; left: 50%; translate: -50% 0; margin: 0; opacity: 0;
    padding: var(--e-2) var(--e-4); border: 1px solid rgba(201, 165, 92, 0.45); border-radius: 999px;
    background: rgba(13, 13, 13, 0.55); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    color: var(--oro-claro); font-size: 0.875rem; white-space: nowrap;
  }
  .inmersion__nota {
    position: absolute;
    left: calc(50% + (var(--x) - 50%) * var(--abre, 1));
    top: var(--y);
    translate: -50% -50%;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.75rem, 1.5rem + 5vw, 6.5rem);
    font-weight: 600;
    color: #fffaf0;
    /* Sombra en capas para leer sobre el video */
    text-shadow: 0 2px 3px rgba(0, 0, 0, 0.55), 0 4px 18px rgba(0, 0, 0, 0.75), 0 0 48px rgba(0, 0, 0, 0.6);
    white-space: nowrap;
    opacity: 0;
    will-change: transform, opacity, filter;
  }
  /* Sombra de cada palabra */
  .inmersion__nota::before {
    content: ''; position: absolute; inset: -35% -18%; z-index: -1;
    background: radial-gradient(closest-side, rgba(13, 13, 13, 0.55), transparent);
  }

  .inmersion__final { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: var(--e-4); text-align: center; padding-inline: var(--e-5); opacity: 0; z-index: 4; }
  .inmersion__perfume { margin: 0; font-size: 0.75rem; letter-spacing: var(--tracking-etiqueta); text-transform: uppercase; color: var(--oro-claro); }
  .inmersion__frase { margin: 0; font-family: var(--serif); font-size: var(--t-h2); line-height: 1.05; color: var(--blanco); max-width: 16ch; }
  .inmersion__precio { margin: 0 0 var(--e-2); color: var(--texto); }
  .inmersion__precio [data-elixir-precio] { font-family: var(--serif); font-size: 1.75rem; color: var(--oro-claro); }
  .inmersion__acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--e-3); }

  @media (max-width: 767px) {
    .inmersion { height: 480vh; }
    .inmersion__frasco { height: 44svh; margin-top: 28svh; }
    .inmersion__nota { --abre: 0.3; font-size: 2.5rem; }
    .inmersion__acciones { flex-direction: column; width: 100%; max-width: 20rem; }
  }

  /* Sin movimiento */
  .inmersion--quieta { height: auto; }
  .inmersion--quieta .inmersion__escena { position: relative; height: auto; min-height: 100svh; padding-block: var(--e-9); gap: var(--e-6); }
  .inmersion--quieta .inmersion__video[data-escena='3'] { opacity: 1; }
  .inmersion--quieta .inmersion__oscuro { opacity: 1; }
  .inmersion--quieta .inmersion__intro,
  .inmersion--quieta .inmersion__etapa,
  .inmersion--quieta .inmersion__final { position: relative; inset: auto; top: auto; opacity: 1; }
  .inmersion--quieta .inmersion__frasco { margin-top: 0; height: 40svh; }
  .inmersion--quieta .inmersion__etapa { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--e-3); }
  .inmersion--quieta .inmersion__etapa-nombre { position: static; translate: none; opacity: 1; flex-basis: auto; }
  .inmersion--quieta .inmersion__nota { position: static; translate: none; opacity: 1; font-size: 2rem; }
</style>
